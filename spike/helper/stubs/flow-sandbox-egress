#!/bin/sh
# Placeholder for WP02's ruleset loader. It loads an `inet flow_sandbox` table
# so the helper's nft path is exercised end to end - the table must exist before
# the VM starts either way - but it enforces NO policy: the forward chain
# accepts everything and the baseline denylist, declared CIDRs, rate limits and
# the `resolved` set are all WP02's.
#
# The one thing it does do is masquerade, added by WP06 because without it the
# guest has no working network at all: its packets leave the tap with source
# 192.0.2.2, go out the uplink untranslated, and no reply can ever come back.
# That is not policy, it is the plumbing every policy needs, and CONTRACTS
# already assigns it to the real ruleset ("The helper masquerades guest traffic
# out of eth0"). Experiment 4 needs it; WP02 inherits it.
#
# Idempotent by the usual nft trick: declare, delete, then define.
set -eu

uplink=eth0
while [ $# -gt 0 ]; do
    case "$1" in
    --uplink) uplink="$2" && shift 2 ;;
    *) shift ;;
    esac
done

nft -f - <<RULES
table inet flow_sandbox {}
delete table inet flow_sandbox
table inet flow_sandbox {
    chain forward {
        type filter hook forward priority filter; policy accept;
        counter comment "WP02 placeholder: no egress policy is enforced"
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "$uplink" masquerade
    }
}
RULES
