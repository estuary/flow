  "query": "\n        select\n            id as \"id!: models::Id\",\n            user_id,\n            handle,\n            catalog_name,\n            created_at,\n            provider,\n            provider_state,\n            gone_at\n        from internal.sandboxes\n        where catalog_name = any($1) or catalog_name ^@ any($2)\n        order by created_at desc\n        ",
