  "query": "\n            SELECT\n                d.id AS \"id!: models::Id\",\n                d.created_at,\n                d.updated_at,\n                d.detail,\n                (\n                    SELECT count(*)::int4\n                    FROM draft_specs ds\n                    WHERE ds.draft_id = d.id\n                ) AS \"num_specs!\"\n            FROM drafts d\n            WHERE d.id = $1 AND d.user_id = $2\n            ",
