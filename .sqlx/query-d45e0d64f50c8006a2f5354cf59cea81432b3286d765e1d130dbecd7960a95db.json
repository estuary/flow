  "query": "\n                SELECT logged_at, stream, log_line\n                FROM internal.log_lines\n                WHERE token = $1\n                  AND ($2::timestamptz IS NULL OR logged_at > $2)\n                ORDER BY logged_at ASC\n                LIMIT $3\n                ",
