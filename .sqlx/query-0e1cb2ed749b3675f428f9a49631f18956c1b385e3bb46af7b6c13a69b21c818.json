  "query": "\n            SELECT ls.spec::text AS spec, ls.spec_type::text AS spec_type,\n                   dp.data_plane_name::text AS \"data_plane_name?\"\n            FROM live_specs ls\n            LEFT JOIN data_planes dp ON dp.id = ls.data_plane_id\n            WHERE ls.catalog_name = $1\n            FOR SHARE OF ls\n            ",
