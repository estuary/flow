  "query": "\n        insert into internal.sandboxes (id, user_id, handle, catalog_name, provider)\n        select id, $1, $2 || replace(id::text, ':', ''), $3, $4\n        from (select internal.id_generator() as id) as generated\n        returning\n            id as \"id!: models::Id\",\n            user_id,\n            handle,\n            catalog_name,\n            created_at,\n            provider,\n            provider_state,\n            gone_at\n        ",
