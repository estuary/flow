---
source: crates/connector-vmm-tests/tests/launcher.rs
expression: "normalized_calls(&root, &run, &name)"
---
pull ghcr.io/estuary/derive-python:stable --quiet --platform=linux/amd64
image inspect ghcr.io/estuary/derive-python:stable
image inspect --format {{.Id}} <fake image>
run --rm --network=host --log-driver=none --read-only --cap-drop=all --cap-add=CAP_NET_ADMIN --name=fv_<id>-verify --label=dev.estuary.vmm-owner=<token> --label=dev.estuary.vmm-state-dir=<test>/state <fake image id> boundary verify
network create --driver=bridge --interface-name=fvm<id> --label=dev.estuary.vmm-owner=<token> --label=dev.estuary.vmm-state-dir=<test>/state fv_<id>
volume create --driver=image --opt=image=<connector image id> --label=dev.estuary.vmm-owner=<token> --label=dev.estuary.vmm-state-dir=<test>/state fv_<id>
create --rm --name=fv_<id> --network=fv_<id> --log-driver=none --read-only --read-only-tmpfs=false --device=/dev/kvm --device=/dev/net/tun --cap-drop=all --cap-add=CAP_CHOWN --cap-add=CAP_DAC_OVERRIDE --cap-add=CAP_FOWNER --cap-add=CAP_FSETID --cap-add=CAP_NET_ADMIN --cap-add=CAP_NET_BIND_SERVICE --cap-add=CAP_SETGID --cap-add=CAP_SETUID --sysctl=net.ipv4.ip_forward=1 --sysctl=net.ipv4.conf.default.rp_filter=1 --sysctl=net.ipv6.conf.default.disable_ipv6=1 --memory=1342177280 --cpus=2 --mount=type=volume,source=fv_<id>,destination=/rootfs,readonly --mount=type=bind,source=<test>/state/fv_<id>/init,target=/init,readonly --mount=type=bind,source=<mount>,target=<mount>,readonly --mount=type=bind,source=<test>/state/fv_<id>/sock,target=/sock --mount=type=bind,source=<test>/state/fv_<id>/scratch,target=/scratch-backing --env=LOG_FORMAT=json --env=LOG_LEVEL=info --platform=linux/amd64 --label=image=ghcr.io/estuary/derive-python:stable --label=task-name=<spec> --label=task-type=derivation --label=dev.estuary.vmm-owner=<token> --label=dev.estuary.vmm-state-dir=<test>/state <fake image id> run --policy /init/policy.json --connector-mount <mount> --memory-mib 1024 --vcpus 2 --disk-mib 2048
start --attach <container id>
rm --force --time=0 --ignore <container id>
ps --all --no-trunc --filter label=dev.estuary.vmm-owner=<token> --format {{.ID}}
network ls --filter label=dev.estuary.vmm-owner=<token> --format {{.Name}}
network rm fv_<id>
volume ls --filter label=dev.estuary.vmm-owner=<token> --format {{.Name}}
volume rm fv_<id>
