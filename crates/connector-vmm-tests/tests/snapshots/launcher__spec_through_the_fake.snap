---
source: crates/connector-vmm-tests/tests/launcher.rs
expression: "normalized_calls(&root, &run, &name)"
---
pull ghcr.io/estuary/derive-python:stable --quiet --platform=linux/amd64
image inspect ghcr.io/estuary/derive-python:stable
run --rm --network=host --log-driver=none --read-only --cap-drop=all --cap-add=CAP_NET_ADMIN <fake image> boundary verify
network create --driver=bridge --interface-name=fvm<id> --label=dev.estuary.vmm-owner=<token> fv_<id>
create --rm --name=fv_<id> --network=fv_<id> --log-driver=none --read-only --read-only-tmpfs=false --device=/dev/kvm --device=/dev/net/tun --cap-add=CAP_NET_ADMIN --sysctl=net.ipv4.ip_forward=1 --sysctl=net.ipv4.conf.default.rp_filter=1 --sysctl=net.ipv6.conf.default.disable_ipv6=1 --memory=1280m --cpus=2 --mount=type=image,source=ghcr.io/estuary/derive-python:stable,destination=/rootfs,rw=true --mount=type=bind,source=<test>/state/fv_<id>/init,target=/init,readonly --mount=type=bind,source=<mount>,target=<mount>,readonly --mount=type=bind,source=<test>/state/fv_<id>/sock,target=/sock --mount=type=bind,source=<test>/state/fv_<id>/scratch,target=/scratch-backing --env=CONNECTOR_MOUNT=<mount> --env=LOG_FORMAT=json --env=LOG_LEVEL=info --platform=linux/amd64 --label=image=ghcr.io/estuary/derive-python:stable --label=task-name=<spec> --label=task-type=derivation --label=dev.estuary.vmm-owner=<token> <fake image> run --policy /init/policy.json --connector-mount <mount> --memory-mib 1024 --vcpus 2 --disk-mib 2048
start --attach <container id>
rm --force --time=0 --ignore <container id>
ps --all --no-trunc --filter label=dev.estuary.vmm-owner=<token> --format {{.ID}}
network ls --filter label=dev.estuary.vmm-owner=<token> --format {{.Name}}
network rm fv_<id>
