---
source: crates/python-connector/src/project.rs
expression: "default_pyproject(\"acmeCo-orders\", &dependencies)"
---
[project]
name = "acmeCo-orders"
version = "0.1.0"
requires-python = ">=3.14,<4"
dependencies = [
    "httpx>=0.27",
    "pydantic>=2",
]

[dependency-groups]
dev = ["pyright>=1.1"]

[tool.uv]
package = false
exclude-newer = "7 days"

[tool.pyright]
typeCheckingMode = "strict"
extraPaths = ["flow_generated/python"]
