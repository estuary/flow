    [
        "b.py",
    ],
    true,
    "{\"_python\":{\"files\":{\"a.py\":\"x = 1\\n\",\"b.py\":null,\"uv.lock\":\"lock\"},\"spec\":{\"configSchema\":{\"type\": \"object\"}}},\"credentials\":{\"token\":\"secret\"},\"module\":\"a user property\"}",
    ProjectConfig {
        project: Project {
            files: {
                "a.py": Some(
                    "x = 1\n",
                ),
                "b.py": None,
                "uv.lock": Some(
                    "lock",
                ),
            },
            spec: Spec {
                config_schema: Some(
