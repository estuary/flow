# nothing was made
FindContainers -> FindsNothing
FindNetworks -> FindsNothing
RemoveRecord

# only the mount was made
FindContainers -> FindsNothing
FindNetworks -> FindsNothing
RemoveMount -> Removes
RemoveRecord

# everything was made
FindContainers -> Finds
RemoveContainers(["0123abcd"]) -> Removes
FindNetworks -> Finds
RemoveNetworks(["fv_0123456789abcdef"]) -> Removes
