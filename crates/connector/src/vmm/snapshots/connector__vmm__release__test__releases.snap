RemoveState -> Removes
RemoveRecord

# everything, already gone
FindContainers -> FindsNothing
FindNetworks -> FindsNothing
RemoveMount -> Removes
RemoveState -> Removes
RemoveRecord

# the container query fails
FindContainers -> Fails
Keep
  left container fv_0123456789abcdef: refused

# the container removal fails
FindContainers -> Finds
RemoveContainers(["0123abcd"]) -> Fails
Keep
  left container fv_0123456789abcdef: refused

# the network query fails
