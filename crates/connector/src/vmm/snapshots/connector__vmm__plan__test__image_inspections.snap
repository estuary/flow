---
source: crates/connector/src/vmm/plan.rs
expression: table
---
# no label: the defaults alone
labels {} ports {}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# hosts beyond the defaults, lowercased, without repeats
labels {"dev.estuary.egress-hosts":"[\"api.acmeco.example\", \"*.ACMEco.example\", \"PyPI.org\", \"api.acmeco.example\"]"} ports {}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=api.acmeco.example --egress-host=*.acmeco.example --egress-host=task.acmeco.example

# an empty label
labels {"dev.estuary.egress-hosts":""} ports {}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# a blank label
labels {"dev.estuary.egress-hosts":"  "} ports {}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# an empty array
labels {"dev.estuary.egress-hosts":"[]"} ports {}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# not JSON
labels {"dev.estuary.egress-hosts":"pypi.org, files.pythonhosted.org"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' must be a JSON array of host names: "pypi.org, files.pythonhosted.org": expected value at line 1 column 1

# not an array
labels {"dev.estuary.egress-hosts":"{\"hosts\": [\"pypi.org\"]}"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' must be a JSON array of host names: "{\"hosts\": [\"pypi.org\"]}": invalid type: map, expected a sequence at line 1 column 0

# not strings
labels {"dev.estuary.egress-hosts":"[\"pypi.org\", 443]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' must be a JSON array of host names: "[\"pypi.org\", 443]": invalid type: integer `443`, expected a string at line 1 column 16

# a URL
labels {"dev.estuary.egress-hosts":"[\"https://api.acmeco.example\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "https://api.acmeco.example" has a label outside [a-z0-9-]: "https://api"

# a port
labels {"dev.estuary.egress-hosts":"[\"api.acmeco.example:443\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "api.acmeco.example:443" has a label outside [a-z0-9-]: "example:443"

# an address
labels {"dev.estuary.egress-hosts":"[\"93.184.216.34\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "93.184.216.34" ends in an all-numeric label; image label 'dev.estuary.egress-hosts' takes names, not addresses

# a CIDR
labels {"dev.estuary.egress-hosts":"[\"93.184.216.0/24\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "93.184.216.0/24" has a label outside [a-z0-9-]: "0/24"

# everything
labels {"dev.estuary.egress-hosts":"[\"*\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "*" has a wildcard other than a leading "*.", the only form supported

# a wildcard over a public suffix
labels {"dev.estuary.egress-hosts":"[\"*.github.io\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "*.github.io" is a wildcard over the public suffix "github.io", in the Public Suffix List's private section; names beneath a public suffix belong to unrelated registrants

# a wildcard beneath a private suffix
labels {"dev.estuary.egress-hosts":"[\"*.acmeco.github.io\"]"} ports {}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=*.acmeco.github.io --egress-host=task.acmeco.example

# a single label
labels {"dev.estuary.egress-hosts":"[\"localhost\"]"} ports {}
=> refused: connector image 'ghcr.io/estuary/derive-python:stable': image label 'dev.estuary.egress-hosts' "localhost" is a single label, which cannot resolve publicly

# a public port
labels {"dev.estuary.port-public.8080":"true"} ports {"8080/tcp":{}}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# a private port
labels {} ports {"8080/tcp":{},"9090":{}}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# only a UDP port, which ordinary launches ignore too
labels {} ports {"9000/udp":{}}
=> --egress-host=pypi.org --egress-host=files.pythonhosted.org --egress-host=task.acmeco.example

# another protocol
labels {"FLOW_RUNTIME_PROTOCOL":"capture"} ports {}
=> refused: connector protocol Capture does not match requested type Derivation
