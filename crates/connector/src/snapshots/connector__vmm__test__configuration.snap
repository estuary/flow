---
source: crates/connector/src/vmm.rs
expression: table
---
# nothing set
=> None

# no state directory, so nothing else is read
CONNECTOR_VMM_DISK_MIB=x
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
=> None

# an empty state directory
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=
=> None

# an empty image is this build's
CONNECTOR_VMM_IMAGE=
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Ok(
            Memory {
                bytes: 1073741824,
                guest_mib: 768,
            },
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# defaults
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Ok(
            Memory {
                bytes: 1073741824,
                guest_mib: 768,
            },
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# every setting
CONNECTOR_CGROUP_PARENT=estuary-connectors.slice
CONNECTOR_CPU_LIMIT=1.5
CONNECTOR_MEMORY_LIMIT=2g
CONNECTOR_VMM_DISK_MIB=4096
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_MEMORY_OVERHEAD_MIB=128
CONNECTOR_VMM_PODMAN=/usr/local/bin/podman
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "/usr/local/bin/podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 4096,
        memory: Ok(
            Memory {
                bytes: 2147483648,
                guest_mib: 1920,
            },
        ),
        cpu_limit: "1.5",
        vcpus: 2,
        cgroup_parent: Some(
            "estuary-connectors.slice",
        ),
    },
)

# empty VMM settings take their defaults
CONNECTOR_VMM_DISK_MIB=
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_MEMORY_OVERHEAD_MIB=
CONNECTOR_VMM_PODMAN=
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Ok(
            Memory {
                bytes: 1073741824,
                guest_mib: 768,
            },
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# an empty memory limit is used as an ordinary launch uses it
CONNECTOR_MEMORY_LIMIT=
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Err(
            "CONNECTOR_MEMORY_LIMIT \"\": expected a decimal number as Go's ParseFloat reads one, then optionally a unit: b, or k, m, g, t or p with an optional b or ib, in any case",
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a relative state directory
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=var/lib/flow
=> error: CONNECTOR_VMM_STATE_DIR "var/lib/flow": is not an absolute path

# a malformed disk size
CONNECTOR_VMM_DISK_MIB=2g
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> error: CONNECTOR_VMM_DISK_MIB "2g": expected a whole number of MiB

# a malformed overhead
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_MEMORY_OVERHEAD_MIB=-1
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> error: CONNECTOR_VMM_MEMORY_OVERHEAD_MIB "-1": expected a whole number of MiB

# an overhead consuming the whole limit, which refuses VMM starts only
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_MEMORY_OVERHEAD_MIB=1024
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Err(
            "CONNECTOR_MEMORY_LIMIT \"1g\", less 1024 MiB of VMM overhead: leaves no guest RAM",
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a fractional memory limit
CONNECTOR_MEMORY_LIMIT=1.5g
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Ok(
            Memory {
                bytes: 1610612736,
                guest_mib: 1280,
            },
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a memory limit with an upper-case unit
CONNECTOR_MEMORY_LIMIT=1536MiB
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Ok(
            Memory {
                bytes: 1610612736,
                guest_mib: 1280,
            },
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a memory limit of zero, which engines read as none
CONNECTOR_MEMORY_LIMIT=0
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Err(
            "CONNECTOR_MEMORY_LIMIT \"0\", less 256 MiB of VMM overhead: is no limit at all to the engine, and a VMM's guest RAM is sized within one",
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a memory limit beyond 32 bits of guest MiB
CONNECTOR_MEMORY_LIMIT=4294967552m
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Err(
            "CONNECTOR_MEMORY_LIMIT \"4294967552m\", less 256 MiB of VMM overhead: leaves 4294967296 MiB of guest RAM, above 4294967295",
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a memory limit with an exponent
CONNECTOR_MEMORY_LIMIT=1.5e3m
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Ok(
            Memory {
                bytes: 1572864000,
                guest_mib: 1244,
            },
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a memory limit the engines wrap to none
CONNECTOR_MEMORY_LIMIT=8192p
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Err(
            "CONNECTOR_MEMORY_LIMIT \"8192p\": is at least 2^63 bytes, which the engines wrap to no limit at all",
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a hexadecimal memory limit, which the engines read
CONNECTOR_MEMORY_LIMIT=0x1p30
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> Some(
    Vmm {
        image: "ghcr.io/estuary/connector-vmm:dev",
        podman: "podman",
        state_dir: "/var/lib/flow/connector-vmm",
        disk_mib: 2048,
        memory: Err(
            "CONNECTOR_MEMORY_LIMIT \"0x1p30\": expected a decimal number as Go's ParseFloat reads one, then optionally a unit: b, or k, m, g, t or p with an optional b or ib, in any case",
        ),
        cpu_limit: "2",
        vcpus: 2,
        cgroup_parent: None,
    },
)

# a malformed CPU limit
CONNECTOR_CPU_LIMIT=two
CONNECTOR_VMM_IMAGE=ghcr.io/estuary/connector-vmm:dev
CONNECTOR_VMM_STATE_DIR=/var/lib/flow/connector-vmm
=> error: CONNECTOR_CPU_LIMIT "two": expected a decimal number of CPUs, with at most nine fraction digits
