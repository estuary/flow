---
source: crates/control-plane-api/src/server/public/graphql/billing/plan.rs
expression: plans
---
[
    (
        "contract paid through Stripe",
        Contract(
            ContractPlan {
                collection_method: ChargeDefaultPaymentMethod,
                payment_provider: Stripe,
                data_tiers: [
                    PricingTier {
                        rate_cents: 50,
                        quantity: None,
                    },
                ],
                usage_tiers: [
                    PricingTier {
                        rate_cents: 14,
                        quantity: Some(
                            4464,
                        ),
                    },
                    PricingTier {
                        rate_cents: 7,
                        quantity: None,
                    },
                ],
            },
        ),
    ),
    (
        "contract on GCP marketplace, paid by sent invoice",
        Contract(
            ContractPlan {
                collection_method: SendInvoice,
