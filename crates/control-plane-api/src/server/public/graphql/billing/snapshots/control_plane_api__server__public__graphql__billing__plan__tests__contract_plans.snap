                    },
                    PricingTier {
                        rate_cents: 7,
                        quantity: None,
                    },
                ],
            },
        ),
    ),
    (
        "contract on Snowflake marketplace",
        Contract(
            ContractPlan {
                collection_method: ChargeDefaultPaymentMethod,
                payment_provider: SnowflakeMarketplace,
                data_tiers: [
                    PricingTier {
                        rate_cents: 50,
                        quantity: None,
                    },
                ],
                usage_tiers: [
                    PricingTier {
                        rate_cents: 14,
