---
source: crates/control-plane-api/src/server/public/graphql/billing/plan.rs
expression: plans
---
[
  {
    "response": {
      "data": {
        "tenant": {
          "billing": {
            "plan": {
              "__typename": "SelfServePlan",
              "collectionMethod": "CHARGE_DEFAULT_PAYMENT_METHOD",
              "phase": "FREE",
              "trial": null
            }
          }
        }
      }
    },
    "step": "select 'newly provisioned'"
  },
  {
    "response": {
      "data": {
        "tenant": {
          "billing": {
            "plan": {
              "__typename": "SelfServePlan",
              "collectionMethod": "SEND_INVOICE",
              "phase": "PAID",
              "trial": {
                "end": "2024-02-29",
                "start": "2024-01-31"
              }
            }
          }
        }
      }
    },
    "step": "update tenants set trial_start = '2024-01-31', collection_method = 'send_invoice' where tenant = 'billingplan/'"
  },
  {
    "response": {
      "data": {
        "tenant": {
          "billing": {
            "plan": {
              "__typename": "ContractPlan",
              "collectionMethod": "SEND_INVOICE",
              "includedUsage": {
                "dataGb": 1024,
                "taskHours": 1440
              },
              "paymentProvider": "AWS_MARKETPLACE"
            }
          }
        }
      }
    },
    "step": "update tenants set plan_kind = 'contract', payment_provider = 'aws_marketplace', data_tiers = '{0,1024,50}', usage_tiers = '{0,1440,14}' where tenant = 'billingplan/'"
  },
  {
    "response": {
      "data": {
        "tenant": {
          "billing": {
            "plan": {
              "__typename": "InternalPlan",
              "detail": null
            }
          }
        }
      }
    },
    "step": "update tenants set plan_kind = 'internal' where tenant = 'billingplan/'"
  }
]
