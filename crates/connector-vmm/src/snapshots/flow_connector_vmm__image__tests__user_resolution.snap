---
source: crates/connector-vmm/src/image.rs
expression: table
---
"" -> 0:0
"acme" -> 1000:1001
"1000" -> 1000:1001
"0" -> 0:0
"1234" -> 1234:0
"acme:acmegrp" -> 1000:1002
"acme:1002" -> 1000:1002
"1234:acmegrp" -> 1234:1002
"1000:acmegrp" -> 1000:1002
"root" -> 0:0
"nobody" -> refused: user "nobody" is not in the image's /etc/passwd
"acme:nogroup" -> refused: group "nogroup" is not in the image's /etc/group
"" with no passwd file -> 0:0
"acme" with no passwd file -> refused: user "acme" is not in the image's /etc/passwd
