---
source: crates/connector-vmm/src/ruleset.rs
expression: table
---
# declared
# flow-connector-vmm egress ruleset: allowedNames=1 declaredCidrs=3 ttlFloorSecs=90 ttlCapSecs=3600
table inet flow_egress {}
delete table inet flow_egress

table inet flow_egress {
	set baseline {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 168.63.129.16/32, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4, 10.89.0.0/24, 192.0.2.0/30 }
	}

	set excluded {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 192.0.2.0/24, 224.0.0.0/4, 240.0.0.0/4, 10.89.0.0/24, 192.0.2.0/30 }
	}

	set resolved {
		type ipv4_addr
		flags timeout
		size 1024
	}

	set declared {
		type ipv4_addr
		flags interval
		elements = { 10.0.0.0/8, 93.184.216.0/24, 192.168.4.7/32 }
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		iifname "tap0" ip saddr != 192.0.2.2 counter drop comment "anti-spoof"
		ct state established,related counter accept comment "replies"
		meta nfproto ipv6 counter drop comment "no-ipv6"
		meta l4proto != { tcp, udp } counter drop comment "tcp-udp-only"
		ip daddr @excluded counter drop comment "excluded"
		ip daddr @baseline ip daddr != @declared counter drop comment "baseline"
		tcp dport 25 counter drop comment "smtp"
		ct state new counter jump egress_accept comment "egress"
		counter comment "forward-drop"
	}

	chain egress_accept {
		ip daddr @resolved counter accept comment "resolved"
		ip daddr @declared counter accept comment "declared"
	}

	chain input {
		type filter hook input priority filter; policy drop;
		iif lo counter accept comment "loopback"
		iifname "tap0" ip saddr != 192.0.2.2 counter drop comment "anti-spoof"
		ct state established,related counter accept comment "replies"
		iifname "tap0" ip saddr 192.0.2.2 ip daddr 192.0.2.1 udp dport 53 counter accept comment "tap-dns"
		counter comment "input-drop"
	}

	chain output {
		type filter hook output priority filter; policy accept;
		oifname "tap0" ct state != established counter drop comment "no-inbound"
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 192.0.2.2 oifname "eth0" counter masquerade comment "masquerade"
	}
}

# empty
- # flow-connector-vmm egress ruleset: allowedNames=1 declaredCidrs=3 ttlFloorSecs=90 ttlCapSecs=3600
- 	set excluded {
- 		elements = { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 192.0.2.0/24, 224.0.0.0/4, 240.0.0.0/4, 10.89.0.0/24, 192.0.2.0/30 }
- 	set declared {
- 		elements = { 10.0.0.0/8, 93.184.216.0/24, 192.168.4.7/32 }
- 		ip daddr @excluded counter drop comment "excluded"
- 		ip daddr @baseline ip daddr != @declared counter drop comment "baseline"
- 		ip daddr @declared counter accept comment "declared"
+ # flow-connector-vmm egress ruleset: allowedNames=0 declaredCidrs=0 ttlFloorSecs=90 ttlCapSecs=3600
+ 		ip daddr @baseline counter drop comment "baseline"

# every address
- # flow-connector-vmm egress ruleset: allowedNames=1 declaredCidrs=3 ttlFloorSecs=90 ttlCapSecs=3600
- 		elements = { 10.0.0.0/8, 93.184.216.0/24, 192.168.4.7/32 }
+ # flow-connector-vmm egress ruleset: allowedNames=0 declaredCidrs=1 ttlFloorSecs=90 ttlCapSecs=3600
+ 		elements = { 0.0.0.0/0 }

# allowed names
- # flow-connector-vmm egress ruleset: allowedNames=1 declaredCidrs=3 ttlFloorSecs=90 ttlCapSecs=3600
- 	set excluded {
- 		elements = { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 192.0.2.0/24, 224.0.0.0/4, 240.0.0.0/4, 10.89.0.0/24, 192.0.2.0/30 }
- 	set declared {
- 		elements = { 10.0.0.0/8, 93.184.216.0/24, 192.168.4.7/32 }
- 		ip daddr @excluded counter drop comment "excluded"
- 		ip daddr @baseline ip daddr != @declared counter drop comment "baseline"
- 		ip daddr @declared counter accept comment "declared"
+ # flow-connector-vmm egress ruleset: allowedNames=3 declaredCidrs=0 ttlFloorSecs=120 ttlCapSecs=1800
+ 		ip daddr @baseline counter drop comment "baseline"

# empty, with ingress
- # flow-connector-vmm egress ruleset: allowedNames=1 declaredCidrs=3 ttlFloorSecs=90 ttlCapSecs=3600
- 	set excluded {
- 		elements = { 0.0.0.0/8, 127.0.0.0/8, 169.254.0.0/16, 192.0.2.0/24, 224.0.0.0/4, 240.0.0.0/4, 10.89.0.0/24, 192.0.2.0/30 }
- 	set declared {
- 		elements = { 10.0.0.0/8, 93.184.216.0/24, 192.168.4.7/32 }
- 		ip daddr @excluded counter drop comment "excluded"
- 		ip daddr @baseline ip daddr != @declared counter drop comment "baseline"
- 		ip daddr @declared counter accept comment "declared"
+ # flow-connector-vmm egress ruleset: allowedNames=0 declaredCidrs=0 ttlFloorSecs=90 ttlCapSecs=3600
+ 		iifname "eth0" oifname "tap0" ip daddr 192.0.2.2 ct status dnat tcp dport { 8080, 9090 } counter accept comment "ingress"
+ 		ip daddr @baseline counter drop comment "baseline"
+ 	chain prerouting {
+ 		type nat hook prerouting priority dstnat; policy accept;
+ 		iifname "eth0" fib daddr type local tcp dport { 8080, 9090 } counter dnat ip to 192.0.2.2 comment "ingress"
