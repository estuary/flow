## the image sets no HOME
CONNECTOR_MOUNT=/connector-mount
PATH=/usr/bin
HOME=/home/acmesvc

## the image's own HOME
CONNECTOR_MOUNT=/connector-mount
PATH=/usr/bin
HOME=/opt/acmeCo

## an empty image HOME, which podman replaces
CONNECTOR_MOUNT=/connector-mount
PATH=/usr/bin
HOME=
HOME=/home/acmesvc
