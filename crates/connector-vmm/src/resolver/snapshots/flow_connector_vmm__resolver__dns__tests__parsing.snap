# shorter than a header
unscreened: message of 8 bytes: short message
refused: message of 8 bytes: short message

# one A record
addresses: [93.184.216.34]
records: [A 93.184.216.34 ttl 300]

# an A record in another class
addresses: [93.184.216.34]
records: []

# the owner name as a backward compression pointer
addresses: [93.184.216.34]
records: [A 93.184.216.34 ttl 300]

# a forward compression pointer
unscreened: record: too many compression pointers
refused: answer record: too many compression pointers

# a CNAME target of the root
