"""Entry point of a materialization, generated by Estuary. It runs the
`Materialization` which the materialization's directory exports."""
import asyncio
import collections.abc
import importlib.util
import inspect
import json
import os
import pathlib
import pydantic
import sys
import traceback
import types
import typing

from MODULE_PATH import IMaterialization, Request, Response


LOAD_TASK

Materialization: type[IMaterialization[typing.Any, typing.Any, typing.Any]] = task.Materialization


def binding_of(message: typing.Any) -> str:
    """Discriminate a Load or Store by its `binding`, which is omitted if zero."""
    if isinstance(message, dict):
        return str(typing.cast(dict[str, typing.Any], message).get("binding", 0))
    return str(getattr(message, "binding", 0))


# Each binding's Load and Store types, indexed by its `binding`.
LOADS: list[type[pydantic.BaseModel]] = [
LOAD_TYPES
]
STORES: list[type[pydantic.BaseModel]] = [
STORE_TYPES
]


def discriminated(models: list[type[pydantic.BaseModel]], fallback: type[pydantic.BaseModel]) -> typing.Any:
    """A union of `models`, discriminated by `binding`."""
    if not models:
        return fallback
    if len(models) == 1:
        return models[0]
    return typing.Annotated[
        typing.Union[tuple(typing.Annotated[model, pydantic.Tag(str(index))] for index, model in enumerate(models))],
        pydantic.Discriminator(binding_of),
    ]


# Unions are built at runtime and hidden from pyright, which fails to analyze
# a written-out union of a few hundred members. Each binding's methods are
# instead typed by its own messages in IMaterialization.
if typing.TYPE_CHECKING:
    Load = typing.Any
    Store = typing.Any
else:
    Load = discriminated(LOADS, Request.Load)
    Store = discriminated(STORES, Request.Store)


class Envelope(pydantic.BaseModel):
    """A request of the session, which has one set field."""

    load: Load | None = None
    flush: Request.Flush | None = None
    store: Store | None = None
    startCommit: Request.StartCommit | None = None
    acknowledge: Request.Acknowledge | None = None


def emit(field: str, message: pydantic.BaseModel, flush: bool) -> None:
    """Write one Response, as an envelope over its single set field.

    Fields which were never set are omitted, rather than written as nulls.
    A loaded document which was parsed from the endpoint then round-trips as
    it was stored, and an unset field of a state update leaves its state as-is
    (where a null is an RFC 7396 merge-patch deletion). A field which is set to
    None is written as a null.
    """
    print(f'{{"{field}":{message.model_dump_json(by_alias=True, exclude_unset=True)}}}', flush=flush)


async def stdin_lines() -> typing.AsyncGenerator[bytes, None]:
    loop = asyncio.get_event_loop()
    reader = asyncio.StreamReader(limit=1 << 27)  # 128 MiB.
    protocol = asyncio.StreamReaderProtocol(reader)
    await loop.connect_read_pipe(lambda: protocol, sys.stdin)

    while line := await reader.readline():
        yield line


def type_arguments() -> tuple[typing.Any, typing.Any, typing.Any]:
    """Resolve the types `C` (of `config`), `R` (of each binding's resource
    configuration), and `S` (of connector state) which Materialization
    declares by subclassing IMaterialization, falling back to
    IMaterialization's defaults for those it omits.

    The materialization's messages are always parsed with the types it
    declares, which may differ from the generated types."""
    defaults: list[typing.Any] = [param.__default__ for param in IMaterialization.__type_params__]

    for base in types.get_original_bases(Materialization):
        if base is IMaterialization:
            return defaults[0], defaults[1], defaults[2]
        if typing.get_origin(base) is IMaterialization:
            args: list[typing.Any] = [*typing.get_args(base), *defaults[len(typing.get_args(base)):]]
            return args[0], args[1], args[2]

    raise TypeError(
        "Materialization must directly subclass IMaterialization, as `class Materialization(IMaterialization)` "
        "or `class Materialization(IMaterialization[MyConfig, MyResourceConfig, MyState])`"
    )


def parse[M: pydantic.BaseModel](model: type[M], message: typing.Any, name: str) -> M:
    """Parse a request `message` into `model`. Its configuration carries merged
    secrets, so errors are reported without their input values."""
    try:
        return model.model_validate(message)
    except pydantic.ValidationError as err:
        details = err.errors(include_input=False, include_url=False)
        lines = [f"  /{'/'.join(str(loc) for loc in detail['loc'])}: {detail['msg']}" for detail in details]
        print(f"materialization {name} is invalid:\n" + "\n".join(lines), file=sys.stderr)
        sys.exit(1)


async def validate(config_type: typing.Any, resource_type: typing.Any) -> None:
    """Validate the materialization, reading its Request.Validate and a default
    Response.Validated from stdin, and printing the Response.Validated which the
    materialization's `validate` modifies."""
    given = json.loads(sys.stdin.buffer.read())
    if inspect.isabstract(Materialization):
        missing = ", ".join(sorted(Materialization.__abstractmethods__))
        print(f"Materialization must implement {missing}, which IMaterialization declares abstract", file=sys.stderr)
        sys.exit(1)

    validate = parse(Request.Validate[config_type, resource_type], given["validate"], "Validate")
    validated = Response.Validated.model_validate(given["validated"])

    await Materialization.validate(validate, validated)
    print(validated.model_dump_json(by_alias=True))


async def apply(config_type: typing.Any, resource_type: typing.Any, state_type: typing.Any) -> None:
    """Apply the materialization, reading its Request.Apply from stdin
    and printing its Response.Applied."""
    apply = parse(Request.Apply[config_type, resource_type, state_type], json.loads(sys.stdin.buffer.read()), "Apply")
    applied = Response.Applied[state_type]()

    await Materialization.apply(apply, applied)
    print(applied.model_dump_json(by_alias=True, exclude_unset=True))


class Executor:
    """Runs work as tasks of a TaskGroup, at most `limit` at once.

    Tasks begin in the order they're submitted, as the event loop starts
    tasks in the order they're created. When every task is busy, `submit`
    waits for one to finish. The session then reads no further requests, which
    pushes back on the runtime. A task which fails cancels the TaskGroup, and
    with it the session.
    """

    def __init__(self, group: asyncio.TaskGroup, limit: int, name: str):
        if limit < 1:
            raise ValueError(f"{name} must be at least one, not {limit}")
        self.group = group
        self.idle = asyncio.Semaphore(limit)
        self.running: set[asyncio.Task[None]] = set()

    async def submit(self, work: collections.abc.Coroutine[typing.Any, typing.Any, None]) -> None:
        await self.idle.acquire()
        task = self.group.create_task(self.run(work))
        self.running.add(task)
        task.add_done_callback(self.running.discard)

    async def run(self, work: collections.abc.Coroutine[typing.Any, typing.Any, None]) -> None:
        try:
            await work
        finally:
            self.idle.release()

    async def drain(self) -> None:
        """Wait for every submitted task to finish."""
        if self.running:
            await asyncio.wait(set(self.running))


async def load(loads: collections.abc.AsyncIterator[Response.Loaded[typing.Any]]) -> None:
    """Write each document which a load yields, as it's yielded. Writes don't
    await, so a load which yields isn't interrupted by other tasks."""
    async for loaded in loads:
        emit("loaded", loaded, flush=False)


async def acknowledge(
    materialization: IMaterialization[typing.Any, typing.Any, typing.Any],
    request: Request.Acknowledge,
    state_type: typing.Any,
) -> None:
    acknowledged = Response.Acknowledged[state_type]()
    await materialization.acknowledge(request, acknowledged)
    emit("acknowledged", acknowledged, flush=True)


async def serve(
    group: asyncio.TaskGroup,
    lines: typing.AsyncGenerator[bytes, None],
    materialization: IMaterialization[typing.Any, typing.Any, typing.Any],
    state_type: typing.Any,
) -> None:
    """Serve the requests of a session, which follow its Open."""

    # Each binding's methods, indexed by its `binding` as are LOADS and STORES.
    # Pyright can't relate an index to a method's message, so they're typed loosely.
    load_methods: list[collections.abc.Callable[[typing.Any], collections.abc.AsyncIterator[Response.Loaded[typing.Any]]]] = [
LOAD_METHODS
    ]
    store_methods: list[collections.abc.Callable[[typing.Any], collections.abc.Coroutine[typing.Any, typing.Any, None]]] = [
STORE_METHODS
    ]
    loads = Executor(group, materialization.concurrent_loads, "concurrent_loads")
    stores = Executor(group, materialization.concurrent_stores, "concurrent_stores")

    async for line in lines:
        request = Envelope.model_validate_json(line)

        if request.load:
            index: int = request.load.binding
            await loads.submit(load(load_methods[index](request.load)))

        elif request.flush:
            await loads.drain()

            flushed = Response.Flushed[state_type]()
            async for loaded in materialization.flush(request.flush, flushed):
                emit("loaded", loaded, flush=False)
            emit("flushed", flushed, flush=True)

        elif request.store:
            index: int = request.store.binding
            await stores.submit(store_methods[index](request.store))

        elif request.startCommit:
            await stores.drain()

            started = Response.StartedCommit[state_type]()
            await materialization.start_commit(request.startCommit, started)
            emit("startedCommit", started, flush=True)

        elif request.acknowledge:
            # Acknowledge runs concurrently with the loads of the next
            # transaction. The runtime sends no Flush until it's Acknowledged.
            group.create_task(acknowledge(materialization, request.acknowledge, state_type))

        else:
            raise RuntimeError(f"unexpected request: {line[:256]!r}")


async def session(config_type: typing.Any, resource_type: typing.Any, state_type: typing.Any) -> None:
    """Open the materialization, and serve its session until its requests end."""
    lines = stdin_lines()
    open = parse(
        Request.Open[config_type, resource_type, state_type],
        json.loads(await lines.__anext__())["open"],
        "Open",
    )
    materialization, opened = await Materialization.open(open)
    emit("opened", opened, flush=True)

    async with asyncio.TaskGroup() as group:
        await serve(group, lines, materialization, state_type)


def first_error(error: BaseException) -> BaseException:
    """The first error of a (nested) group, which is the cause of the others'
    cancellation."""
    exceptions: tuple[BaseException, ...] = getattr(error, "exceptions", ())
    if isinstance(error, BaseExceptionGroup) and exceptions:
        return first_error(exceptions[0])
    # Pyright narrows `error` to a group of unknown exceptions.
    return typing.cast(BaseException, error)


if __name__ == "__main__":
    config_type, resource_type, state_type = type_arguments()

    try:
        if sys.argv[1:] == ["validate"]:
            asyncio.run(validate(config_type, resource_type))
        elif sys.argv[1:] == ["apply"]:
            asyncio.run(apply(config_type, resource_type, state_type))
        else:
            asyncio.run(session(config_type, resource_type, state_type))
    except Exception as error:
        # The final log is the task's error. Exit without finalizing the
        # interpreter, whose warnings (such as of unclosed resources) would
        # otherwise follow it.
        traceback.print_exception(first_error(error))
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(1)
