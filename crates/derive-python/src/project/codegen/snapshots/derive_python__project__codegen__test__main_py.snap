"""Entry point of a derivation, generated by Estuary. It runs the `Derivation`
which the derivation's directory exports."""
import asyncio
import collections.abc
import importlib.util
import inspect
import json
import os
import pathlib
import pydantic
import sys
import traceback
import types
import typing

from patterns.sums import Document, IDerivation, Request, Response


def load_task() -> typing.Any:
    """Load the task's directory, its `__init__.py`, as package `__flow_task__`."""
    directory = pathlib.Path(__file__).resolve().parent.parent / "sums"
    spec = importlib.util.spec_from_file_location(
        "__flow_task__",
        directory / "__init__.py",
        submodule_search_locations=[str(directory)],
    )
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


task: typing.Any = load_task()


Derivation: type[IDerivation[typing.Any, typing.Any, typing.Any]] = task.Derivation


def transform_of(message: typing.Any) -> str:
    """Discriminate a Read by its `transform`, which is omitted if zero."""
    if isinstance(message, dict):
        return str(typing.cast(dict[str, typing.Any], message).get("transform", 0))
    return str(getattr(message, "transform", 0))


# Each transform's Read type, indexed by its `transform`.
READS: list[type[pydantic.BaseModel]] = [
    Request.ReadFromInts,
    Request.ReadProcessStrings,
]


def discriminated(models: list[type[pydantic.BaseModel]], fallback: type[pydantic.BaseModel]) -> typing.Any:
    """A union of `models`, discriminated by `transform`. A derivation whose
    transforms are all disabled has none, and reads nothing."""
    if not models:
        return fallback
    if len(models) == 1:
        return models[0]
    return typing.Annotated[
        typing.Union[tuple(typing.Annotated[model, pydantic.Tag(str(index))] for index, model in enumerate(models))],
        pydantic.Discriminator(transform_of),
    ]


# A union is built at runtime and hidden from pyright, which fails to analyze
# a written-out union of a few hundred members. Each transform's method is
# instead typed by its own Read in IDerivation.
if typing.TYPE_CHECKING:
    Read = typing.Any
else:
    Read = discriminated(READS, Request.Read)


class Envelope(pydantic.BaseModel):
    """A request of the session, which has one set field."""

    read: Read | None = None
    flush: Request.Flush | None = None
    reset: Request.Reset | None = None


def emit(field: str, message: pydantic.BaseModel, flush: bool) -> None:
    """Write one Response, as an envelope over its single set field.

    Fields which were never set are omitted, rather than written as nulls.
    A published document then has only the fields it was given, as its
    collection's schema may not allow a null where it allows an omission. An
    unset field of a state update leaves its state as-is (where a null is an
    RFC 7396 merge-patch deletion). A field which is set to None is written
    as a null.
    """
    print(f'{{"{field}":{message.model_dump_json(by_alias=True, exclude_unset=True)}}}', flush=flush)


async def stdin_lines() -> typing.AsyncGenerator[bytes, None]:
    loop = asyncio.get_event_loop()
    reader = asyncio.StreamReader(limit=1 << 27)  # 128 MiB.
    protocol = asyncio.StreamReaderProtocol(reader)
    await loop.connect_read_pipe(lambda: protocol, sys.stdin)

    while line := await reader.readline():
        yield line


def type_arguments() -> tuple[typing.Any, typing.Any, typing.Any]:
    """Resolve the types `C` (of `config`), `R` (of each transform's resource
    configuration), and `S` (of connector state) which Derivation declares by
    subclassing IDerivation, falling back to IDerivation's defaults for those
    it omits.

    The derivation's messages are always parsed with the types it declares,
    which may differ from the generated types."""
    defaults: list[typing.Any] = [param.__default__ for param in IDerivation.__type_params__]

    for base in types.get_original_bases(Derivation):
        if base is IDerivation:
            return defaults[0], defaults[1], defaults[2]
        if typing.get_origin(base) is IDerivation:
            args: list[typing.Any] = [*typing.get_args(base), *defaults[len(typing.get_args(base)):]]
            return args[0], args[1], args[2]

    raise TypeError(
        "Derivation must directly subclass IDerivation, as `class Derivation(IDerivation)` "
        "or `class Derivation(IDerivation[MyConfig, MyResourceConfig, MyState])`"
    )


def parse[M: pydantic.BaseModel](model: type[M], message: typing.Any, name: str) -> M:
    """Parse a request `message` into `model`. Its configuration carries merged
    secrets, so errors are reported without their input values."""
    try:
        return model.model_validate(message)
    except pydantic.ValidationError as err:
        details = err.errors(include_input=False, include_url=False)
        lines = [f"  /{'/'.join(str(loc) for loc in detail['loc'])}: {detail['msg']}" for detail in details]
        print(f"derivation {name} is invalid:\n" + "\n".join(lines), file=sys.stderr)
        sys.exit(1)


async def validate(config_type: typing.Any, resource_type: typing.Any) -> None:
    """Validate the derivation, reading its Request.Validate and a default
    Response.Validated from stdin, and printing the Response.Validated which the
    derivation's `validate` modifies."""
    given = json.loads(sys.stdin.buffer.read())
    if inspect.isabstract(Derivation):
        missing = ", ".join(sorted(Derivation.__abstractmethods__))
        print(f"Derivation must implement {missing}, which IDerivation declares abstract", file=sys.stderr)
        sys.exit(1)

    validate = parse(Request.Validate[config_type, resource_type], given["validate"], "Validate")
    validated = Response.Validated.model_validate(given["validated"])

    await Derivation.validate(validate, validated)
    print(validated.model_dump_json(by_alias=True))


async def serve(
    lines: typing.AsyncGenerator[bytes, None],
    derivation: IDerivation[typing.Any, typing.Any, typing.Any],
    state_type: typing.Any,
) -> None:
    """Serve the requests of a session, which follow its Open."""

    # Each transform's method, indexed by its `transform` as are READS.
    # Pyright can't relate an index to a method's Read, so they're typed loosely.
    transform_methods: list[collections.abc.Callable[[typing.Any], collections.abc.AsyncIterator[Document]]] = [
        derivation.transform_from_ints,
        derivation.transform_process_strings,
    ]
    # Each published document is wrapped in this model, which is resolved once.
    published = Response.Published[Document]

    async for line in lines:
        request = Envelope.model_validate_json(line)

        if request.read:
            index: int = request.read.transform
            async for doc in transform_methods[index](request.read):
                emit("published", published(doc=doc), flush=False)

        elif request.flush:
            flushed = Response.Flushed[state_type]()
            async for doc in derivation.flush(request.flush, flushed):
                emit("published", published(doc=doc), flush=False)
            emit("flushed", flushed, flush=True)

        elif request.reset:
            await derivation.reset()

        else:
            raise RuntimeError(f"unexpected request: {line[:256]!r}")


async def session(config_type: typing.Any, resource_type: typing.Any, state_type: typing.Any) -> None:
    """Open the derivation, and serve its session until its requests end."""
    lines = stdin_lines()
    open = parse(
        Request.Open[config_type, resource_type, state_type],
        json.loads(await lines.__anext__())["open"],
        "Open",
    )
    derivation, opened = await Derivation.open(open)
    emit("opened", opened, flush=True)

    await serve(lines, derivation, state_type)


if __name__ == "__main__":
    config_type, resource_type, state_type = type_arguments()

    try:
        if sys.argv[1:] == ["validate"]:
            asyncio.run(validate(config_type, resource_type))
        else:
            asyncio.run(session(config_type, resource_type, state_type))
    except Exception:
        # The final log is the task's error. Exit without finalizing the
        # interpreter, whose warnings (such as of unclosed resources) would
        # otherwise follow it.
        traceback.print_exc()
        sys.stdout.flush()
        sys.stderr.flush()
        os._exit(1)
