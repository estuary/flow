---
source: crates/shuffle/src/log/state.rs
expression: "trace.join(\"\\n\")"
---
on_request(0, 1, empty) -> Some(0/0)
    should_start: false, FlushState { started: 0, completed: 0, flushed_lsn: 0/0, requested: 0, awaiting: [None, None, None, None, None, None] }
on_request(1, 1, non-empty) -> None
    should_start: true, FlushState { started: 0, completed: 0, flushed_lsn: 0/0, requested: 1, awaiting: [None, Some((1, 1)), None, None, None, None] }
on_request(2, 1, non-empty) -> None
    should_start: true, FlushState { started: 0, completed: 0, flushed_lsn: 0/0, requested: 1, awaiting: [None, Some((1, 1)), Some((1, 1)), None, None, None] }
on_started -> ()
    should_start: false, FlushState { started: 1, completed: 0, flushed_lsn: 0/0, requested: 1, awaiting: [None, Some((1, 1)), Some((1, 1)), None, None, None] }
on_request(3, 1, empty) -> None
    should_start: false, FlushState { started: 1, completed: 0, flushed_lsn: 0/0, requested: 1, awaiting: [None, Some((1, 1)), Some((1, 1)), Some((1, 1)), None, None] }
on_request(4, 2, non-empty) -> None
    should_start: false, FlushState { started: 1, completed: 0, flushed_lsn: 0/0, requested: 2, awaiting: [None, Some((1, 1)), Some((1, 1)), Some((1, 1)), Some((2, 2)), None] }
on_request(5, 2, non-empty) -> None
    should_start: false, FlushState { started: 1, completed: 0, flushed_lsn: 0/0, requested: 2, awaiting: [None, Some((1, 1)), Some((1, 1)), Some((1, 1)), Some((2, 2)), Some((2, 2))] }
accumulate(full) -> true
    should_start: false, FlushState { started: 1, completed: 0, flushed_lsn: 0/0, requested: 2, awaiting: [None, Some((1, 1)), Some((1, 1)), Some((1, 1)), Some((2, 2)), Some((2, 2))] }
on_completed(1/0) -> [(1, 1), (2, 1), (3, 1)]
    should_start: true, FlushState { started: 1, completed: 1, flushed_lsn: 1/0, requested: 2, awaiting: [None, None, None, None, Some((2, 2)), Some((2, 2))] }
on_started -> ()
    should_start: false, FlushState { started: 2, completed: 1, flushed_lsn: 1/0, requested: 2, awaiting: [None, None, None, None, Some((2, 2)), Some((2, 2))] }
on_completed(1/1) -> [(4, 2), (5, 2)]
    should_start: true, FlushState { started: 2, completed: 2, flushed_lsn: 1/1, requested: 2, awaiting: [None, None, None, None, None, None] }
take -> true
    should_start: false, FlushState { started: 2, completed: 2, flushed_lsn: 1/1, requested: 2, awaiting: [None, None, None, None, None, None] }
on_request(0, 2, empty) -> Some(1/1)
    should_start: false, FlushState { started: 2, completed: 2, flushed_lsn: 1/1, requested: 2, awaiting: [None, None, None, None, None, None] }
