---
source: crates/shuffle/src/log/buffer.rs
expression: "trace.join(\"\\n\")"
---
pop p0@30 -> append @30 ""
released -> 0
pop p0@20 -> append @20 ""
released -> 0
pop p0@30 -> barrier, flush: None
released -> 100
pop p0@25 -> append @25 ""
released -> 100
pop p0@35 -> barrier, flush: Some(7)
released -> 150
pop p0@40 -> barrier, flush: None
released -> 160
on_round([60], barrier @50) -> Err("Slice's Barrier 50 is below a prior Append at 60")
delta-decoded -> ["acmeCo/one/pivot=00", "acmeCo/one/pivot=00", "acmeCo/one/pivot=11"]
merge -> Gated(slice: 0)
all caught up -> s0: [|p1@0]; s1: [|p0@0]; s2: [|p0@0]; Idle
s1 [p0@100]|110, s2 |90 -> s2: [|p0@90]; Gated(slice: 2)
s2 |105 flush 9 -> s1: [p0@100]; s2: [|p0@105 flush 9]; Gated(slice: 2)
s2 [p0@110]|110 -> s1: [|p0@110]; s2: [p0@110, |p0@110]; Gated(slice: 1)
s1 [p0@120]|120, s2 caught up, s0 [p1@500]|500 -> s0: [p1@500, |p1@500]; Gated(slice: 0)
s0 caught up -> s0: [|p1@500]; s2: [|p0@110]; s1: [p0@120, |p0@120]; Gated(slice: 1)
s1 [p0@130]|140, [p0@125]|150 -> s1: [p0@130, |p0@140, p0@125, |p0@150]; Gated(slice: 1)
