---
source: crates/shuffle/src/log/buffer.rs
expression: "trace.join(\"\\n\")"
---
on_round([], flush 3) -> Some(3)
on_round([30, 20, 25], flush 7) -> None
peek -> Some("p0@30")
pop -> clock 30, released: None
peek -> Some("p0@20")
pop -> clock 20, released: None
peek -> Some("p0@25")
pop -> clock 25, released: Some(7)
drained -> true
delta-decoded -> ["acmeCo/one/pivot=00", "acmeCo/one/pivot=00", "acmeCo/one/pivot=11"]
merge -> Idle
s1 [p0@100] -> Ready(slice: 1, through: MAX)
s2 [p0@90] -> Ready(slice: 2, through: p0@100)
s0 [p1@200] -> Ready(slice: 0, through: p0@90)
run -> s0: [p1@200]
run -> s2: [p0@90]
s2 [p0@100] -> Ready(slice: 1, through: p0@100)
run -> s1: [p0@100]
s1 [95, 92, 100] flush 9 -> s1: [p0@95, p0@92, p0@100 released 9]
run -> s2: [p0@100]
run -> Idle
