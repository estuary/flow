---
source: crates/shuffle/src/log/read_ahead.rs
expression: "trace.join(\"\\n\")"
---
new -> INITIAL
constrain(10) -> At(10)
on_round(flush 3) -> Some(3)
pop -> clock: 20, flags: 0, released: None
pop -> clock: 20, flags: 1, released: None
on_round([40], 41, flush 7) -> None
pop -> clock: 25, flags: 0, released: None
pop -> clock: 30, flags: 0, released: None
pop -> clock: 35, flags: 0, released: None
pop -> clock: 40, flags: 0, released: Some(7)
drained -> barrier: None, queued_bytes: 0
drained -> At(41)
on_append(window - 1) -> window_open: false
pop -> window_open: true
delta-decoded -> ["acmeCo/one/pivot=00", "acmeCo/one/pivot=00", "acmeCo/one/pivot=11"], first two shared: true
merge -> Idle
s0 append(100) -> Constrained(1)
s1-3 tailing, s4 EOF -> Ready(slice: 0, through: MAX)
s1, s2 constrain(200) -> Ready(slice: 0, through: 200)
s1 append(99) -> Ready(slice: 1, through: 100)
s2 constrain(99) -> Ready(slice: 1, through: 99)
s2 append(99) -> Ready(slice: 1, through: 99)
s1 pop -> Ready(slice: 2, through: 100)
s2 pop, s1 constrain(99) -> Constrained(1)
s1 constrain(150) -> Constrained(2)
s2 constrain(100) -> Ready(slice: 0, through: 100)
s0 pop, append(priority -1, 1) -> Constrained(2)
