---
source: crates/shuffle/src/log/read_ahead.rs
expression: "trace.join(\"\\n\")"
---
on_round([], flush 3) -> Some(3)
peek -> Some("p0@30")
pop -> clock 30, flags: 0, released: None
peek -> Some("p0@20")
pop -> clock 20, flags: 0, released: None
peek -> Some("p0@25")
pop -> clock 25, flags: 1, released: None
peek -> None
on_round([40], flush 7) -> None
pop -> clock 30, flags: 0, released: None
pop -> clock 40, flags: 0, released: Some(7)
pop -> clock 25, flags: 0, released: None
drained -> barrier: None, queued_bytes: 0
on_round([4/8, 4/8]) -> Ok(None), queued: 8/8, merged: 0/8
pop, on_round([4/8]) -> Ok(None), queued: 8/8, merged: 4/8
on_round([doc]) -> Err("Slice exceeded its Append credits: an Append of 132 bytes with 4194304 bytes queued exceeds 4194304"), queued: 8/8, merged: 4/8
pop x2, on_round([16/8]) -> Ok(None), queued: 16/8, merged: 12/8
pop -> merged: 28/8
delta-decoded -> ["acmeCo/one/pivot=00", "acmeCo/one/pivot=00", "acmeCo/one/pivot=11"]
merge -> Constrained(slice: 0)
idle rounds -> Idle
s1 [p0@100] -> Ready(slice: 1, through: MAX)
s2 [p0@90] -> Ready(slice: 2, through: p0@100)
s0 [p1@200] -> Ready(slice: 0, through: p0@90)
run -> s0: [p1@200]
run -> s2: [p0@90]
s2 [p0@100] -> Ready(slice: 1, through: p0@100)
s1 [95, 92, 100] flush 9, [101] -> s1: [p0@100, p0@95, p0@92, p0@100 released 9]
run -> s2: [p0@100]
run -> s1: [p0@101]
run -> Idle
s1 [p0@200], s2 constrains @150 -> Constrained(slice: 2)
s2 constrains @250 -> Ready(slice: 1, through: p0@250)
s2 constrains @200 -> s1: [p0@200]
s1 [p0@300], s2 idle, s0 constrains @900 -> Constrained(slice: 0)
s0 idle -> s1: [p0@300]
s1 [p0@500], s0 delayed @100, s2 delayed @450 -> Constrained(slice: 2)
s2 delayed @600 -> s1: [p0@500]
s1 [p0@400] constrains @350 -> s1: [p0@400]
run -> Constrained(slice: 1)
s1 EOF -> Idle
