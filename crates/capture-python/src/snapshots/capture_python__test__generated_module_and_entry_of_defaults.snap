"""Entry point of a capture, generated by Estuary. It runs the `Connector`
which the capture's directory exports."""
import asyncio
import importlib.util
import pathlib
import sys
import typing


def load_task() -> typing.Any:
    """Load the task's directory, its `__init__.py`, as package `__flow_task__`."""
    directory = pathlib.Path(__file__).resolve().parent.parent / "source-acme"
    spec = importlib.util.spec_from_file_location(
        "__flow_task__",
        directory / "__init__.py",
        submodule_search_locations=[str(directory)],
    )
    assert spec is not None and spec.loader is not None
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


task: typing.Any = load_task()


asyncio.run(task.Connector().serve())
