"""Generated types of capture acmeCo/source-acme, from its declared `spec`."""
import pydantic as _pydantic
from estuary_cdk.capture import common
from estuary_cdk.flow import ConnectorSpec


# Generated for the endpoint configuration of `spec.configSchema`.
class EndpointConfig(_pydantic.BaseModel):
    model_config = _pydantic.ConfigDict(extra='allow')




# `spec.resourceConfigSchema` isn't declared, so each binding's resource
# configuration is the CDK's stock `ResourceConfig`.
ResourceConfig = common.ResourceConfig

# The connector specification of the capture. A Spec is answered from the
# capture's model and not by this connector, so `spec()` returns it only so
# that the connector is complete.
SPEC = ConnectorSpec(
    configSchema={},
    resourceConfigSchema={"properties": {"interval": {"default": "PT0S", "description": "Interval between updates for this resource", "format": "duration", "nonsensitive": True, "type": "string"}, "name": {"description": "Name of this resource", "type": "string", "x-collection-name": True}}, "required": ["name"], "type": "object"},
    documentationUrl="https://docs.estuary.dev",
    resourcePathPointers=ResourceConfig.PATH_POINTERS,
    oauth2=None,
)

