#!/usr/bin/env bash
set -euo pipefail

#MISE description="Start control plane agent via systemd (for this stack)"
#MISE depends=["build:local-rust", "local:tls-cert", "local:supabase", "local:bigtable"]

source "$(dirname "$0")/lib.sh"
ensure_stack_env
prepare_dirs

NAME="${FLOW_STACK_NAME}"

# This stack's flowctl profile, holding only its endpoints and public token.
# It's the profile of sandbox containers (see the agent env below), and the
# base of the developer's own profile (end of this script). It must never hold
# user tokens: every sandbox workspace gets a copy. It's rewritten in place
# rather than replaced, so running containers' bind mounts of it see updates.
SANDBOX_PROFILE="${FLOW_STACK_DIR}/sandbox-profile.json"
PG_PUBLIC_TOKEN="$(sign_jwt '{"iss":"supabase-demo","role":"anon","exp":1983812996}')"
jq -n \
    --arg agent_url "http://localhost:${FLOW_PORT_AGENT}/" \
    --arg pg_url "http://localhost:${FLOW_PORT_SUPABASE_API}/rest/v1" \
    --arg dashboard_url "${FLOW_DASHBOARD_ORIGIN}/" \
    --arg config_encryption_url "http://localhost:${FLOW_PORT_CONFIG_ENC}/" \
    --arg pg_public_token "${PG_PUBLIC_TOKEN}" \
    '{$agent_url, $pg_url, $dashboard_url, $config_encryption_url, $pg_public_token}' \
    > "${SANDBOX_PROFILE}"

# Agent env: this stack's API port, per-stack builds root and DB/bigtable ports,
# plus the common build/runtime vars (CARGO_TARGET_DIR for the binary path,
# FLOW_ROOT for the build step) and the two CORS origins the unit passes as
# --allow-origin flags: the global FLOW_DASHBOARD_ORIGIN and the optional
# per-stack UI at FLOW_PORT_DASHBOARD (base+5).
{
    emit_common_vars
    cat <<EOF

# Agent environment for stack ${NAME}.
# SSL_CERT_FILE is required for calls made to brokers and reactors.

API_PORT=${FLOW_PORT_AGENT}
FLOW_DASHBOARD_ORIGIN=${FLOW_DASHBOARD_ORIGIN}
FLOW_PORT_DASHBOARD=${FLOW_PORT_DASHBOARD}
BUILDS_ROOT=file://${FLOW_STACK_DIR}/builds/
CONTROL_PLANE_JWT_SECRET=${FLOW_JWT_SECRET}
DATABASE_URL=postgresql://postgres:postgres@db.flow.localhost:${FLOW_PORT_SUPABASE_DB}/postgres
LOG_FORMAT=text
CONTROLLER_MAX_JOBS=10
SERVE_ALERT_NOTIFICATIONS=true
NO_COLOR=1
RUST_LOG=info
SERVE_HANDLERS=true
SSL_CERT_FILE=${FLOW_LOCAL}/ca.crt

# Decrypts data-plane HMAC keys. Its public half is the age recipient to which
# local:data-plane encrypts them. No other service holds this key.
SOPS_AGE_KEY=AGE-SECRET-KEY-1M3S7XA3T4URLM24XCEA3PCXZGEWN3UHML6ST4YG70AUD7FGUN4EQJRKR6X

# Local stacks run the V2 task runtime for every newly-created task: the agent
# stamps enable-runtime-v2 onto new captures, derivations, and materializations
# at publication time. Existing tasks and explicit per-task flags are unaffected.
# See RuntimeV2Rollout in crates/control-plane-api.
RUNTIME_V2_NEW_CAPTURES=true
RUNTIME_V2_NEW_DERIVATIONS=true
RUNTIME_V2_NEW_MATERIALIZATIONS=true

BIGTABLE_PROJECT=estuary-local
BIGTABLE_INSTANCE=estuary-local
BIGTABLE_EMULATOR_HOST=localhost:${FLOW_PORT_BIGTABLE}

# New sandboxes are containers of flow-sandbox:local (mise run local:sandbox-image),
# which run this stack's debug flowctl. Each new workspace copies this stack's
# profile from the workspace skeleton, as flowctl's default profile. The image's
# entrypoint adds the CA to the system trust store, so flowctl trusts this stack's
# brokers and reactors. See "Sandbox containers" in local/README.md.
SANDBOX_PROVIDER=docker
DOCKER_SANDBOX_IMAGE=flow-sandbox:local
DOCKER_SANDBOX_FLOWCTL=${CARGO_TARGET_DIR}/debug/flowctl
DOCKER_SANDBOX_SCOPE=${NAME}
DOCKER_SANDBOX_MOUNT=${FLOW_LOCAL}/ca.crt:/opt/estuary/ca.crt,${SANDBOX_PROFILE}:/opt/estuary/skel/.config/flowctl/default.json
EOF
} > "${FLOW_ENV_DIR}/agent-${NAME}.env"

# Forward STRIPE_API_KEY from the invoking shell when set
# (e.g. a testmode key pasted before `mise run`). Without it, billing
# GraphQL operations return an error indicating billing is not configured.
if [ -n "${STRIPE_API_KEY:-}" ]; then
    echo "STRIPE_API_KEY=${STRIPE_API_KEY}" >> "${FLOW_ENV_DIR}/agent-${NAME}.env"
fi

# Forward SPRITES_TOKEN from the invoking shell when set. It configures the
# Sprites sandbox provider, which serves sandboxes whose records name it.
# New sandboxes are still Docker containers.
if [ -n "${SPRITES_TOKEN:-}" ]; then
    echo "SPRITES_TOKEN=${SPRITES_TOKEN}" >> "${FLOW_ENV_DIR}/agent-${NAME}.env"
fi

{
    emit_common_vars
    cat <<EOF

# Config-encryption service environment for stack ${NAME}.
API_PORT=${FLOW_PORT_CONFIG_ENC}
RUST_LOG=info

# This matches SOPS_AGE_KEY in the reactor development task.
KMS_TYPE=age
KMS_KEY=age1z2qskpk8ww2rx5frxzykryufkfm9sj03v56m3qu54y0lgndytp3sdg24vs

# First-class secrets are wrapped under a second, separate keychain, and
# SOPS_AGE_KEY below is its private half. It appears in this env file and
# nowhere else: unlike KMS_KEY, whose private half the reactor task also holds,
# the authority to unwrap a secret belongs to config-encryption alone. Reactors
# reach their plaintext only by asking, and only for the secrets which the
# control-plane authorizes them to have.
SECRETS_KMS_TYPE=age
SECRETS_KMS_KEY=age1x4kj9xj8n9w0zjtz04m7eq2ahaec3kg6hsvp02hj2s5t42adcacqzq3ep0
SOPS_AGE_KEY=AGE-SECRET-KEY-15HVSX9LVZT2FHEUN0N3W7HZG5G5JJKK8ED4UZ3T88M7ZDDW6U50S5L063P

# Control-plane API which authorizes each decryption.
CONTROL_PLANE_URL=http://localhost:${FLOW_PORT_AGENT}/
EOF
} > "${FLOW_ENV_DIR}/config-encryption-${NAME}.env"

# Install the templated control-plane units (relink from this checkout).
link_unit flow-control-agent@.service
link_unit flow-config-encryption@.service
link_unit flow-control-plane@.target
systemctl --user daemon-reload
systemctl --user start "flow-control-plane@${NAME}.target"

# Generate this stack's flowctl profile for the developer. Every stack's profile
# needs explicit URLs: flowctl no longer compiles in any local defaults (ports are
# per-stack and dynamic). URLs are refreshed on every start because a checkout's
# index (and thus its ports) can change across re-allocations after a slot is
# reclaimed; a prior `flowctl --profile ${NAME} login` may have stored tokens we
# must preserve, so when a profile already exists we merge new URLs into it
# rather than overwrite.
PROFILE_DIR="${HOME}/.config/flowctl"
PROFILE_FILE="${PROFILE_DIR}/${NAME}.json"
mkdir -p "${PROFILE_DIR}"
if [ -f "${PROFILE_FILE}" ]; then
    # Refresh URLs and the public token in place, preserving login tokens
    # (user_access_token / user_refresh_token) and any other fields.
    jq -s '.[0] * .[1]' "${PROFILE_FILE}" "${SANDBOX_PROFILE}" > "${PROFILE_FILE}.tmp"
    mv "${PROFILE_FILE}.tmp" "${PROFILE_FILE}"
    echo "Refreshed flowctl profile ${PROFILE_FILE} (use: flowctl --profile ${NAME})"
else
    cp "${SANDBOX_PROFILE}" "${PROFILE_FILE}"
    echo "Wrote flowctl profile ${PROFILE_FILE} (use: flowctl --profile ${NAME})"
fi

# The Supabase CLI derives its anon key from the signing secret, as the same
# claims as its well-known key. A stack with its own secret has its own key.
if [ -s "${FLOW_STACK_DIR}/jwt-secret" ]; then
    echo "This stack has its own signing secret. The dashboard needs its anon key:"
    echo "  VITE_SUPABASE_ANON_KEY=${PG_PUBLIC_TOKEN}"
fi

echo "Control-plane started. Check status with: systemctl --user status flow-control-plane@${NAME}.target"
echo "  Status: systemctl --user list-dependencies flow-control-plane@${NAME}.target"
