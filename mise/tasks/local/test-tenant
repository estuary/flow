#!/usr/bin/env bash
set -euo pipefail

#MISE description="Provision a tenant via the onboarding API and emit flowctl credentials"
#MISE depends=["local:control-plane"]
#USAGE flag "--tenant <tenant>" help="Tenant name without trailing slash (default: test)"
#USAGE flag "--user <user>" help="Email of an auth.users row to own the tenant (default: alice@example.com). NOTE: onboarding API rejects users that already administer a tenant, so each seeded user (alice/bob/carol/dave from seed.sql) can own at most one tenant."

source "$(dirname "$0")/lib.sh"
ensure_stack_env

TENANT="${usage_tenant:-test}"
USER_EMAIL="${usage_user:-alice@example.com}"
PGURL="postgresql://postgres:postgres@localhost:${FLOW_PORT_SUPABASE_DB}/postgres"
ENV_FILE="${FLOW_STACK_DIR}/test-tenant-${TENANT}.env"
AGENT_PORT="${FLOW_PORT_AGENT}"

# Onboarding rejects names that don't satisfy the catalog_tenant regex.
if [[ ! "${TENANT}" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "Error: --tenant '${TENANT}' must match [A-Za-z0-9._-]+ (no trailing slash, no '/')" >&2
    exit 1
fi
# Guard against SQL injection through unquoted interpolations below.
if [[ ! "${USER_EMAIL}" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]]; then
    echo "Error: --user '${USER_EMAIL}' is not a valid email address" >&2
    exit 1
fi

echo "Waiting for agent on :${AGENT_PORT}..."
ELAPSED=0
TIMEOUT=120
until nc -z localhost "${AGENT_PORT}" 2>/dev/null; do
    sleep 1
    ELAPSED=$((ELAPSED + 1))
    if [ "${ELAPSED}" -ge "${TIMEOUT}" ]; then
        echo "Error: agent did not start within ${TIMEOUT}s" >&2
        exit 1
    fi
done

USER_ID=$(psql "${PGURL}" -tAqc \
    "SELECT id FROM auth.users WHERE email = '${USER_EMAIL}'")
if [ -z "${USER_ID}" ]; then
    echo "Error: no auth.users row with email '${USER_EMAIL}'" >&2
    echo "Hint: seed.sql provisions alice/bob/carol/dave@example.com" >&2
    exit 1
fi

echo "Minting multi-use refresh token for ${USER_EMAIL}..."
# Insert directly (bypassing create_refresh_token's SECURITY DEFINER + auth_uid())
# so we don't need to fake JWT claims. We control the DB here.
TOKEN_JSON=$(psql "${PGURL}" -tAqc "
    WITH gen AS (
        SELECT gen_random_uuid()::text AS secret
    ),
    ins AS (
        INSERT INTO public.refresh_tokens (user_id, multi_use, valid_for, hash, detail)
        SELECT '${USER_ID}'::uuid, true, interval '90 days', crypt(gen.secret, gen_salt('bf')),
               'local:test-tenant'
        FROM gen
        RETURNING id
    )
    SELECT json_build_object('id', ins.id, 'secret', gen.secret)::text
    FROM ins, gen
")
if [ -z "${TOKEN_JSON}" ]; then
    echo "Error: failed to mint refresh token" >&2
    exit 1
fi

FLOW_AUTH_TOKEN=$(printf '%s' "${TOKEN_JSON}" | base64 -w0)

PREFIX="${TENANT}/"
TENANT_EXISTS=$(psql "${PGURL}" -tAqc \
    "SELECT 1 FROM public.tenants WHERE tenant = '${PREFIX}'")

if [ -z "${TENANT_EXISTS}" ]; then
    # Wait until the API snapshot includes a public plane with signing keys.
    echo "Waiting for a public data plane to be ready..."
    ELAPSED=0
    TIMEOUT=120
    while true; do
        # Transient HTTP, transport, or invalid-response failures should retry.
        if PLANES=$(curl --fail-with-body -sS --max-time 10 \
            "http://localhost:${AGENT_PORT}/api/graphql" \
            -H "Authorization: Bearer ${FLOW_AUTH_TOKEN}" \
            -H "Content-Type: application/json" \
            -d '{"query":"{ publicDataPlanes(first: 1) { edges { node { name } } } }"}') &&
            DATA_PLANE=$(jq -r '.data.publicDataPlanes.edges[0].node.name // empty' <<< "${PLANES}") &&
            [ -n "${DATA_PLANE}" ]; then
            break
        fi
        sleep 1
        ELAPSED=$((ELAPSED + 1))
        if [ "${ELAPSED}" -ge "${TIMEOUT}" ]; then
            echo "Error: no public data plane ready within ${TIMEOUT}s" >&2
            echo "Hint: bring up and link a data plane first (mise run local:stack, or" >&2
            echo "      mise run local:data-plane <name> <port> --link)" >&2
            exit 1
        fi
    done

    echo "Provisioning tenant ${PREFIX} owned by ${USER_EMAIL} via onboarding API..."

    TERMS_ID=$(psql "${PGURL}" -tAqc \
        "SELECT id FROM internal.legal_terms WHERE type = 'msa' ORDER BY version DESC LIMIT 1")
    if [ -z "${TERMS_ID}" ]; then
        echo "Error: no MSA terms row found in internal.legal_terms" >&2
        echo "Hint: apply the legal-terms migrations to this stack's database before provisioning a tenant." >&2
        exit 1
    fi
    REQUEST=$(jq -n --arg name "${TENANT}" --arg terms "${TERMS_ID}" --arg plane "${DATA_PLANE}" '{
        query: "mutation($name: String!, $terms: Id!, $plane: String!) { tenantCreate(name: $name, submittingUserAgreesToTermsId: $terms, dataPlane: $plane) }",
        variables: {name: $name, terms: $terms, plane: $plane}
    }')
    RESPONSE=$(curl --fail-with-body -sS --max-time 120 \
        "http://localhost:${AGENT_PORT}/api/graphql" \
        -H "Authorization: Bearer ${FLOW_AUTH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "${REQUEST}")
    if ! jq -e '.data.tenantCreate == true and (.errors | length == 0)' <<< "${RESPONSE}" >/dev/null; then
        echo "Error: tenantCreate failed: ${RESPONSE}" >&2
        exit 1
    fi
    echo "Tenant ${PREFIX} provisioned."
else
    echo "Tenant ${PREFIX} already exists; skipping provisioning."
fi

# Onboarding stamps the default per-tenant quotas (10 tasks / 500 collections).
# Raise the ceiling well above anything a test run could reach.
psql "${PGURL}" -tAqc \
    "UPDATE public.tenants SET tasks_quota = 1000, collections_quota = 1000 WHERE tenant = '${PREFIX}'" >/dev/null

# Close the window where the agent still serves a stale authorization snapshot.
#
# The agent authorizes from an in-memory Snapshot of grants that it refreshes
# only every 20s-5m, so a flowctl call issued the instant we return can race
# ahead of the just-committed grants and be rejected. One authorize request with
# `startedUnix: 0` takes the 307-redirect path; `curl -L` follows it, forcing the
# agent to refresh and block until the new Snapshot lands.
echo "Warming the agent's authorization snapshot for ${PREFIX}..."
if ! warm_authorization "${PGURL}" "${AGENT_PORT}" "${PREFIX}" read; then
    exit 1
fi
echo "Authorization snapshot now reflects ${PREFIX}."

mkdir -p "$(dirname "${ENV_FILE}")"
cat > "${ENV_FILE}" <<EOF
# Generated by mise run local:test-tenant.
# Source this to authenticate flowctl --profile ${FLOW_STACK_NAME} as ${USER_EMAIL}
# against tenant ${PREFIX}.
export FLOW_AUTH_TOKEN='${FLOW_AUTH_TOKEN}'
export FLOW_TEST_TENANT='${TENANT}'
export FLOW_TEST_USER_EMAIL='${USER_EMAIL}'
export FLOW_TEST_USER_ID='${USER_ID}'
EOF

echo "Wrote credentials to ${ENV_FILE}"
echo "  source ${ENV_FILE}"
echo "  flowctl --profile ${FLOW_STACK_NAME} catalog list"
