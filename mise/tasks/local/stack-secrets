#!/usr/bin/env bash
set -euo pipefail

#MISE description="Generate secrets for this stack, in place of the checked-in development values"
#MISE depends=["bootstrap:apt-packages-ci-extra"]

source "$(dirname "$0")/lib.sh"
ensure_stack_env
prepare_dirs

# stack-env exports this file into everything mise runs in this checkout, and
# its values replace the checked-in defaults.
SECRETS_FILE="${FLOW_STACK_DIR}/secrets.env"

# The database, the data-plane registration, and sealed endpoint configs all
# depend on the secrets a stack started with. New secrets under a running stack
# would split it, so they take effect only through a stopped stack.
if systemctl --user is-active --quiet "flow-supabase@${FLOW_STACK_NAME}"; then
    echo "error: stack '${FLOW_STACK_NAME}' is running. Run 'mise run local:stop' first." >&2
    exit 1
fi
if [ -f "${SECRETS_FILE}" ]; then
    echo "error: ${SECRETS_FILE} exists. To rotate, delete it and run this again." >&2
    exit 1
fi

# Print export lines for a new age identity named $1, and its recipient.
age_pair() {
    local identity recipient
    identity="$(age-keygen 2>/dev/null | grep '^AGE-SECRET-KEY-')"
    recipient="$(age-keygen -y <<<"${identity}")"
    printf 'export %s_IDENTITY=%s\nexport %s_RECIPIENT=%s\n' "$1" "${identity}" "$1" "${recipient}"
}

JWT_SECRET="$(openssl rand -hex 32)"
HMAC_SECRET="$(openssl rand -hex 32)"
SUPABASE_SECRET_KEY="sb_secret_$(openssl rand -hex 16)"

# Written aside and then renamed, so that a failure part-way leaves no file.
umask 077
{
    echo "export FLOW_JWT_SECRET=${JWT_SECRET}"
    echo "export FLOW_SUPABASE_SECRET_KEY=${SUPABASE_SECRET_KEY}"
    echo "export FLOW_HMAC_SECRET=${HMAC_SECRET}"
    age_pair FLOW_AGE_HMAC
    age_pair FLOW_AGE_CONFIG
    age_pair FLOW_AGE_SECRETS
} > "${SECRETS_FILE}.tmp"
mv "${SECRETS_FILE}.tmp" "${SECRETS_FILE}"

echo "Wrote ${SECRETS_FILE}. The next 'mise run local:stack' uses it."
