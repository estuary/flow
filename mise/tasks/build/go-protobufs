#!/usr/bin/env bash
#MISE description="Generate Go protobuf bindings"
set -euo pipefail

# Gazette protos are rooted at go/gazette, which is their include path.
# This keeps their registered names (`broker/protocol/protocol.proto`) stable
# for Flow protos and Rust crates which import them.
GAZETTE_PROTO_FILES=(
  "broker/protocol/protocol.proto"
  "consumer/protocol/protocol.proto"
  "consumer/recoverylog/recorded_op.proto"
)
# Gazette protos which also have a gRPC gateway (`<name>_gateway.yaml`).
GAZETTE_GATEWAY_FILES=(
  "broker/protocol/protocol.proto"
  "consumer/protocol/protocol.proto"
)

FLOW_PROTO_FILES=(
  "./go/protocols/capture/capture.proto"
  "./go/protocols/connector/connector.proto"
  "./go/protocols/derive/derive.proto"
  "./go/protocols/flow/flow.proto"
  "./go/protocols/materialize/materialize.proto"
  "./go/protocols/ops/ops.proto"
  "./go/protocols/runtime/runtime.proto"
  "./go/protocols/shuffle/shuffle.proto"
)

# gogoproto/gogo.proto is the only non-local import. google/protobuf/*.proto
# resolve from protoc's system include, installed by libprotobuf-dev.
GOGO_DIR=$(go list -f '{{ .Dir }}' -m github.com/gogo/protobuf)

(
  cd go/gazette
  for proto_file in "${GAZETTE_PROTO_FILES[@]}"; do
    echo "Generating ${proto_file%.proto}.pb.go..."
    protoc -I . -I "$GOGO_DIR" \
      --gogo_out=paths=source_relative,plugins=grpc:. \
      "$proto_file"
  done
  for proto_file in "${GAZETTE_GATEWAY_FILES[@]}"; do
    echo "Generating ${proto_file%.proto}.pb.gw.go..."
    protoc -I . -I "$GOGO_DIR" \
      --grpc-gateway_out=logtostderr=true,paths=source_relative,generate_unbound_methods=false,grpc_api_configuration="${proto_file%.proto}_gateway.yaml":. \
      "$proto_file"
  done
)

for proto_file in "${FLOW_PROTO_FILES[@]}"; do
  echo "Generating $(basename "$proto_file" .proto).pb.go..."
  protoc -I . -I go/gazette -I "$GOGO_DIR" \
    --gogo_out=paths=source_relative,Mgoogle/protobuf/any.proto=github.com/gogo/protobuf/types,Mgoogle/protobuf/timestamp.proto=github.com/gogo/protobuf/types,plugins=grpc:. \
    "$proto_file"
done

echo "✓ All Go protobuf files generated successfully"
