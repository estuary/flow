#!/usr/bin/env bash

#MISE description="Generate Rust sqlx prepared PostgreSQL queries"
#MISE depends=["local:supabase"]

# Pin to the version CI uses (see ci/sqlx-check), so that a locally regenerated
# `.sqlx/` matches what `ci:sqlx-check` compares against.
command -v cargo-sqlx >/dev/null || cargo install sqlx-cli@0.9.0 --no-default-features --features postgres
cargo sqlx prepare --workspace
