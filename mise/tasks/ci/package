#!/usr/bin/env bash
set -euo pipefail

ARCH=$(uname -m)

# Map ARCH to amd64 or arm64 (matching docker architecture names).
if [[ "${ARCH}" == "x86_64" ]]; then
    PACKAGE_ARCH=amd64
elif [[ "${ARCH}" == "aarch64" ]]; then
    PACKAGE_ARCH=arm64
else
    echo "Unsupported architecture: ${ARCH}"
    exit 1
fi
PACKAGE_DIR=${HOME}/flow-package/${PACKAGE_ARCH}/

# Detect source changes made by the builds before recording their artifacts.
source "$(dirname "$0")/../build/identity-lib.sh"
if [[ -n "${EXPECTED_COMMIT:-}" ]]; then
    require_flow_build . "${EXPECTED_COMMIT}" || exit 1
fi

# Cleanup and re-create package directory.
rm -rf ${PACKAGE_DIR} || true
mkdir -p ${PACKAGE_DIR}

cat > ${HOME}/flow-package/tags <<EOF
$(git describe --tags --dirty)
EOF

ln $(which sops) ${PACKAGE_DIR}/sops
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/capture-python ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/derive-python ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/derive-typescript ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/materialize-python ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/flow-connector-init ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/flow-connector-guest-init ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/${ARCH}-unknown-linux-musl/release/flow-parser ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/agent ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/flow-config-encryption ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/flow-connector-vmm ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/data-plane-controller ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/dekaf ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/flow-disk-daemon ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/flowctl ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/oidc-discovery-server ${PACKAGE_DIR}/
ln ${CARGO_TARGET_DIR}/release/runtime-sidecar ${PACKAGE_DIR}/
ln ${GOBIN}/gazette ${PACKAGE_DIR}/
ln ${GOBIN}/gazctl ${PACKAGE_DIR}/
ln ${GOBIN}/flowctl-go ${PACKAGE_DIR}/
ln $(which etcd) ${PACKAGE_DIR}/

# flowctl-go links the `bindings` staticlib, which has no embedded crate list.
# An SBOM of its crates ships beside flowctl-go, and the image scan reads it.
# cargo-cyclonedx writes one beside every workspace crate, so keep only bindings'.
# Build dependencies aren't linked in, and the scan omits them for other binaries.
cargo cyclonedx --quiet \
    --no-build-deps \
    --manifest-path crates/bindings/Cargo.toml \
    --target ${ARCH}-unknown-linux-gnu \
    --format json \
    --spec-version 1.5 \
    --override-filename flowctl-go.cdx
mv crates/bindings/flowctl-go.cdx.json ${PACKAGE_DIR}/
find crates -name flowctl-go.cdx.json -delete

# A VMM built with the test-controls feature accepts --exec. Only the KVM
# suite builds one, in its own target directory, but never ship it.
vmm_help=$("${PACKAGE_DIR}/flow-connector-vmm" run --help)
if [[ "${vmm_help}" == *--exec* ]]; then
    echo "flow-connector-vmm accepts --exec: it was built with the test-controls feature" >&2
    exit 1
fi

# Launchers must pair with the VMM from this release's source commit.
BUILD_RECORD="source $(flow_build_identity . || echo unidentified)"
for launcher in flowctl flowctl-go; do
    reported=$("${PACKAGE_DIR}/${launcher}" build-identity)
    BUILD_RECORD+=$'\n'"${launcher} ${reported}"
    if [[ -n "${EXPECTED_COMMIT:-}" && "${reported}" != "${EXPECTED_COMMIT}" ]]; then
        echo "${launcher} was built as ${reported}, not the expected commit ${EXPECTED_COMMIT}" >&2
        exit 1
    fi
done

cp crates/flow-web/pkg/estuary-flow-web-*.tgz ${HOME}/flow-package/estuary-flow-web.tgz
cp crates/data-plane-controller/entrypoint.sh ${PACKAGE_DIR}/data-plane-controller-entrypoint.sh
cp crates/oidc-discovery-server/entrypoint.sh ${PACKAGE_DIR}/oidc-discovery-server-entrypoint.sh
cp crates/agent/api-entrypoint.sh ${PACKAGE_DIR}/agent-api-entrypoint.sh

# ci:docker-images verifies these after transferring packages between jobs.
printf '%s\n' "${BUILD_RECORD}" >${HOME}/flow-package/${PACKAGE_ARCH}.build
(cd ${HOME}/flow-package && sha256sum ${PACKAGE_ARCH}/*) >${HOME}/flow-package/${PACKAGE_ARCH}.sha256
