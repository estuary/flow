#!/usr/bin/env bash
#MISE description="Verify SQLx query cache is up-to-date"
#MISE depends=["local:supabase"]

set -euo pipefail

# In CI, sqlx-cli is pre-installed and cached by the workflow.
command -v cargo-sqlx || cargo install sqlx-cli@0.8.6 --no-default-features --features postgres

cargo sqlx prepare --workspace --check
