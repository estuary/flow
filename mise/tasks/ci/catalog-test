#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run catalog tests over the derivation examples, and preview the capture-python and materialize-python examples"
#MISE depends=["ci:custom-images"]

# Example derivations run `:local` images of custom connectors (see
# `ci:custom-images`), selected by their `custom-image-tag` shard flag.
#
# `flowctl raw test` runs the catalog's tests locally on the runtime-next stack:
# no Gazette broker, no etcd, no Go consumer. Image derivations still run as
# connector containers, so Docker is required.
#
# CARGO_TARGET_DIR is per-checkout (see mise/tasks/local/stack-env). Connector
# containers mount flow-connector-init (musl) from PATH, which mise's _.path
# covers for ${CARGO_TARGET_DIR}/debug but not the musl dir.
PATH=${PATH}:${CARGO_TARGET_DIR}/debug:${CARGO_TARGET_DIR}/$(uname -m)-unknown-linux-musl/debug \
cargo run --quiet -p flowctl -- raw test --source examples/flow.yaml

# Catalog tests don't run captures, so the capture-python example is checked
# by previewing it: its connector captures a fixed set of documents. Its first
# transaction checkpoints the binding's initialization, and its second has the
# documents, after which the preview stops. Otherwise a capture's session holds
# through its poll interval, until the timeout.
echo "Previewing examples/capture-python against its expected.jsonl..."
PATH=${PATH}:${CARGO_TARGET_DIR}/debug:${CARGO_TARGET_DIR}/$(uname -m)-unknown-linux-musl/debug \
cargo run --quiet -p flowctl -- preview --source examples/capture-python/flow.yaml --sessions 2 --timeout 60s \
    | diff - examples/capture-python/expected.jsonl
echo "✔️  examples/capture-python preview"

# Catalog tests don't run materializations either. The materialize-python
# example writes to the API of `api.py`, which runs in a container on a network
# of its own, which the preview's connector joins. The preview materializes a
# fixture of three transactions across two sessions, so that its later
# transactions load what its earlier ones stored. The API's records must then
# match the example's expected.jsonl.
echo "Previewing examples/materialize-python against its expected.jsonl..."
NETWORK=flow-example-api-$$
docker network create ${NETWORK} >/dev/null
# Connector containers leave the network as they're removed, after the preview exits.
cleanup() {
    docker rm --force example-api-$$ >/dev/null 2>&1 || true
    for _ in $(seq 30); do
        docker network rm ${NETWORK} >/dev/null 2>&1 && return
        sleep 1
    done
    echo "failed to remove docker network ${NETWORK}" >&2
}
trap cleanup EXIT
docker run --detach --rm --name example-api-$$ --network-alias example-api --network ${NETWORK} \
    --mount type=bind,source=$(pwd)/examples/materialize-python/api.py,target=/api.py,readonly \
    python:3.14-slim python /api.py >/dev/null

PATH=${PATH}:${CARGO_TARGET_DIR}/debug:${CARGO_TARGET_DIR}/$(uname -m)-unknown-linux-musl/debug \
cargo run --quiet -p flowctl -- preview --network ${NETWORK} \
    --source examples/materialize-python/flow.yaml \
    --fixture examples/materialize-python/fixture.jsonl --sessions 2,1 --timeout 300s \
    >/dev/null
docker exec example-api-$$ python /api.py dump | diff - examples/materialize-python/expected.jsonl
echo "✔️  examples/materialize-python preview"
