#!/usr/bin/env bash
set -euo pipefail

#MISE description="Run catalog tests over the derivation examples, and preview the capture-python example"
#MISE depends=["ci:custom-images"]

# Example derivations run `:local` images of custom connectors (see
# `ci:custom-images`), selected by their `custom-image-tag` shard flag.
#
# `flowctl raw test` runs the catalog's tests locally on the runtime-next stack:
# no Gazette broker, no etcd, no Go consumer. Image derivations still run as
# connector containers, so Docker is required.
#
# CARGO_TARGET_DIR is per-checkout (see mise/tasks/local/stack-env). Connector
# containers mount flow-connector-init (musl) from PATH, which mise's _.path
# covers for ${CARGO_TARGET_DIR}/debug but not the musl dir.
PATH=${PATH}:${CARGO_TARGET_DIR}/debug:${CARGO_TARGET_DIR}/$(uname -m)-unknown-linux-musl/debug \
cargo run --quiet -p flowctl -- raw test --source examples/flow.yaml

# Catalog tests don't run captures, so the capture-python example is checked
# by previewing it: its connector captures a fixed set of documents. Its first
# transaction checkpoints the binding's initialization, and its second has the
# documents, after which the preview stops. Otherwise a capture's session holds
# through its poll interval, until the timeout.
echo "Previewing examples/capture-python against its expected.jsonl..."
PATH=${PATH}:${CARGO_TARGET_DIR}/debug:${CARGO_TARGET_DIR}/$(uname -m)-unknown-linux-musl/debug \
cargo run --quiet -p flowctl -- preview --source examples/capture-python/flow.yaml --sessions 2 --timeout 60s \
    | diff - examples/capture-python/expected.jsonl
echo "✔️  examples/capture-python preview"
