#!/usr/bin/env bash
set -euo pipefail

# `cargo auditable` embeds each binary's crate list, which image SBOM scanners
# read. `bindings` is a staticlib, which carries none: ci:package writes its SBOM.
FLOW_VERSION=$(git describe --dirty --tags) \
SQLX_OFFLINE=true \
cargo auditable build \
    --locked \
    --release \
    -p agent \
    -p bindings \
    -p config-encryption \
    -p data-plane-controller \
    -p dekaf \
    -p flowctl \
    -p oidc-discovery-server \
    -p runtime-sidecar \