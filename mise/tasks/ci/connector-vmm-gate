#!/usr/bin/env bash
set -euo pipefail

#MISE description="Gate a built VMM image before it is published: its boundary installs, verifies, and refuses each tampering, in a container's own network namespace (needs no KVM, and never touches the host's tables)"
#USAGE arg "<image>" help="The candidate VMM image, as the engine names it"

# ci:docker-images runs this on the image it then publishes. The engine is
# docker unless CONNECTOR_VMM_GATE_ENGINE names another, such as `sudo -n podman`.
IMAGE="${usage_image:-${1:?usage: connector-vmm-gate IMAGE}}"
read -ra ENGINE <<<"${CONNECTOR_VMM_GATE_ENGINE:-docker}"

# The candidate's own nft must list what its binary installed. Tampering is
# defined here independently of the binary, as in kvm::boundary_detects_tampering.
# shellcheck disable=SC2016
GATE='
set -uo pipefail
vmm=/usr/local/bin/flow-connector-vmm
failed=0
ok() {
    local what=$1 out
    shift
    if ! out=$("$@" 2>&1); then
        printf "FAILED %s: %s\n" "${what}" "${out}"
        failed=1
    fi
}
refused() {
    local what=$1 says=$2 out status=0
    shift 2
    out=$("$@" 2>&1) || status=$?
    if [[ "${status}" -ne 2 || "${out}" != *"${says}"* ]]; then
        printf "FAILED %s: exit %s, not 2 naming %q: %s\n" "${what}" "${status}" "${says}" "${out}"
        failed=1
    fi
}

"${vmm}" boundary verify 2>/dev/null | grep "^flow-connector-vmm build "
refused "verify before install" "table is absent" "${vmm}" boundary verify
ok "install" "${vmm}" boundary install
ok "a second install" "${vmm}" boundary install
ok "verify" "${vmm}" boundary verify

edits=(
    "insert rule inet flow_vmm_boundary forward accept|inet forward, rule 0"
    "flush chain inet flow_vmm_boundary input|inet input, rule 0"
    "add table inet flow_vmm_boundary { flags dormant ; }|dormant"
    "delete element inet flow_vmm_boundary baseline { 169.254.0.0/16 }|unexpected: {\"set\""
    "chain inet flow_vmm_boundary input { policy drop ; }|\"policy\":\"drop\""
    "delete table bridge flow_vmm_boundary|the bridge flow_vmm_boundary table is absent"
)
for edit in "${edits[@]}"; do
    ok "${edit%%|*}" nft "${edit%%|*}"
    refused "verify after ${edit%%|*}" "${edit#*|}" "${vmm}" boundary verify
    ok "install after ${edit%%|*}" "${vmm}" boundary install
    ok "verify after reinstalling over ${edit%%|*}" "${vmm}" boundary verify
done

link=fvm0123456789ab
ok "adding VMM bridge ${link}" ip link add "${link}" type dummy
refused "remove beside a VMM bridge" "${link}" "${vmm}" boundary remove
ok "verify after a refused remove" "${vmm}" boundary verify
ok "deleting a table" nft delete table inet flow_vmm_boundary
refused "install over a gap" "${link}" "${vmm}" boundary install
ok "verify after installing over a gap" "${vmm}" boundary verify
ok "deleting VMM bridge ${link}" ip link del "${link}"
ok "remove" "${vmm}" boundary remove
refused "verify after remove" "table is absent" "${vmm}" boundary verify
exit "${failed}"
'

# A killed engine client may leave its container running. Use an exact name
# for cleanup here and by the workflow if this script is killed outright.
NAME="${CONNECTOR_VMM_GATE_NAME:-connector-vmm-gate-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')}"
TIMEOUT="${CONNECTOR_VMM_GATE_TIMEOUT:-300}"

# Whether the engine has a container of exactly NAME: status 0 if it does,
# 1 if it does not, and 2 if it cannot say.
listed() {
    local names
    names=$("${ENGINE[@]}" ps -a --filter "name=${NAME}" --format '{{.Names}}') || return 2
    grep -qxF -- "${NAME}" <<<"${names}"
}

# Remove the container, unless it is already gone, as `run --rm` leaves it.
remove() {
    local attempt found
    for attempt in 1 2 3 4; do
        found=0
        listed || found=$?
        if [[ "${found}" -ne 0 || "${attempt}" -eq 4 ]]; then
            break
        fi
        "${ENGINE[@]}" rm -f "${NAME}" >/dev/null 2>&1 || sleep 1
    done
    case "${found}" in
    1) return 0 ;;
    0) echo "ci:connector-vmm-gate: could not remove container ${NAME}" >&2 ;;
    *) echo "ci:connector-vmm-gate: could not list containers, to remove ${NAME}" >&2 ;;
    esac
    return 1
}

# Exiting while the client may run: stop it, then remove what it ran.
release() {
    local status=$?
    if [[ -n "${CLIENT}" ]]; then
        kill "${CLIENT}" 2>/dev/null || true
        wait "${CLIENT}" 2>/dev/null || true
    fi
    remove || status=1
    exit "${status}"
}

found=0
listed || found=$?
case "${found}" in
0) echo "ci:connector-vmm-gate: a container named ${NAME} exists, and is not this gate's" >&2 && exit 1 ;;
2) echo "ci:connector-vmm-gate: could not list containers" >&2 && exit 1 ;;
esac

echo "=== Gating VMM image ${IMAGE}: boundary install, verify and tampering ==="
CLIENT=
trap release EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# In the background, so that a signal interrupts the wait at once.
timeout --kill-after=10 "${TIMEOUT}" "${ENGINE[@]}" run --rm --name "${NAME}" --network=none \
    --log-driver=none --read-only --cap-drop=all --cap-add=CAP_NET_ADMIN \
    --entrypoint=/bin/bash "${IMAGE}" -c "${GATE}" &
CLIENT=$!
status=0
wait "${CLIENT}" || status=$?
trap - EXIT

case "${status}" in
0) ;;
124) echo "ci:connector-vmm-gate: ${IMAGE}'s gate did not finish within ${TIMEOUT}s" >&2 ;;
*) echo "ci:connector-vmm-gate: ${IMAGE} failed its gate" >&2 ;;
esac
remove || exit 1
[[ "${status}" -eq 0 ]] || exit 1
echo "ci:connector-vmm-gate: ${IMAGE} passed"
