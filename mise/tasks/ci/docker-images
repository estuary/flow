#!/usr/bin/env bash
set -euo pipefail

#MISE description="Build and optionally push multi-arch Docker images"

PACKAGE_DIR="${PACKAGE_DIR:-${HOME}/flow-package}"
TAGS_FILE="${PACKAGE_DIR}/tags"
PUSH="${PUSH:-false}"

# Validate required files exist
if [[ ! -f "${TAGS_FILE}" ]]; then
    echo "Error: Tags file not found at ${TAGS_FILE}" >&2
    exit 1
fi

if [[ ! -d "${PACKAGE_DIR}/amd64" ]] && [[ ! -d "${PACKAGE_DIR}/arm64" ]]; then
    echo "Error: Missing architecture directories in ${PACKAGE_DIR}" >&2
    exit 1
fi

# Read comma-separated tags into array
IFS=',' read -ra TAGS <<< "$(cat "${TAGS_FILE}")"

# Determine platforms and output type based on push mode
if [[ "${PUSH}" == "true" ]]; then
    PLATFORMS='["linux/amd64", "linux/arm64"]'
    OUTPUT='["type=registry"]'
else
    # For local builds, detect current architecture
    ARCH=$(uname -m)
    if [[ "${ARCH}" == "x86_64" ]]; then
        PLATFORMS='["linux/amd64"]'
    elif [[ "${ARCH}" == "aarch64" ]]; then
        PLATFORMS='["linux/arm64"]'
    else
        echo "Error: Unknown architecture ${ARCH}" >&2
        exit 1
    fi
    OUTPUT='["type=docker"]'
fi

# Ensure buildx builder exists and supports multi-arch
BUILDER_NAME="flow-multiarch"
if ! docker buildx inspect "${BUILDER_NAME}" &>/dev/null; then
    echo "Creating buildx builder: ${BUILDER_NAME}"
    docker buildx create --name "${BUILDER_NAME}" --use --bootstrap
else
    docker buildx use "${BUILDER_NAME}"
fi

# Generate bake JSON dynamically from Dockerfiles
BAKE_FILE=$(mktemp)
METADATA_FILE=$(mktemp)
trap "rm -f ${BAKE_FILE} ${METADATA_FILE}" EXIT

# Build the targets object by iterating over Dockerfiles
TARGETS_JSON="{}"
TARGET_NAMES=()

for DOCKERFILE in docker/*.Dockerfile; do
    IMAGE_NAME=$(basename "${DOCKERFILE}" .Dockerfile)

    # The VMM and its fake are amd64 only, matching the libkrun build and KVM suite.
    case "${IMAGE_NAME}" in
    connector-vmm | connector-vmm-fake) IMAGE_SUPPORTED='["linux/amd64"]' ;;
    *) IMAGE_SUPPORTED="${PLATFORMS}" ;;
    esac
    # The VMM image is loaded, never pushed, by the bake: it is gated below,
    # and only the image which passed is published.
    IMAGE_OUTPUT="${OUTPUT}"
    if [[ "${IMAGE_NAME}" == connector-vmm ]]; then
        IMAGE_OUTPUT='["type=docker"]'
    fi
    IMAGE_PLATFORMS=$(echo "${PLATFORMS}" | jq -c --argjson supported "${IMAGE_SUPPORTED}" \
        '[.[] | select(. as $platform | $supported | index($platform))]')
    if [[ "${IMAGE_PLATFORMS}" == "[]" ]]; then
        echo "Skipping ${IMAGE_NAME}: built only for ${IMAGE_SUPPORTED}"
        continue
    fi
    TARGET_NAMES+=("${IMAGE_NAME}")

    # Per-image tags begin with the version tags from ${TAGS_FILE}.
    IMAGE_TAG_NAMES=("${TAGS[@]}")

    # Custom connectors resolve to the `:stable` image, while legacy
    # V1 derivations keep using a frozen `:dev` image (no longer rebuilt here).
    # Publish `:stable` for these.
    if [[ "${IMAGE_NAME}" == "capture-python" || "${IMAGE_NAME}" == "derive-python" || "${IMAGE_NAME}" == "derive-typescript" || "${IMAGE_NAME}" == "materialize-python" ]]; then
        IMAGE_TAG_NAMES+=("stable")
    fi

    # Build tags array for this image
    IMAGE_TAGS=$(printf '%s\n' "${IMAGE_TAG_NAMES[@]}" | jq -R '"ghcr.io/estuary/'"${IMAGE_NAME}"':\(.)"' | jq -s '.')

    # Use absolute path for dockerfile since context is different from CWD
    DOCKERFILE_ABS="$(pwd)/${DOCKERFILE}"

    # Add target to targets object
    TARGETS_JSON=$(echo "${TARGETS_JSON}" | jq \
        --arg name "${IMAGE_NAME}" \
        --arg dockerfile "${DOCKERFILE_ABS}" \
        --arg context "${PACKAGE_DIR}" \
        --argjson tags "${IMAGE_TAGS}" \
        --argjson platforms "${IMAGE_PLATFORMS}" \
        --argjson output "${IMAGE_OUTPUT}" \
        '.[$name] = {
            "dockerfile": $dockerfile,
            "context": $context,
            "tags": $tags,
            "platforms": $platforms,
            "output": $output
        }')
done

# Build the complete bake file
TARGET_NAMES_JSON=$(printf '%s\n' "${TARGET_NAMES[@]}" | jq -R '.' | jq -s '.')
jq -n \
    --argjson targets "${TARGET_NAMES_JSON}" \
    --argjson target "${TARGETS_JSON}" \
    '{
        "group": {
            "default": {
                "targets": $targets
            }
        },
        "target": $target
    }' > "${BAKE_FILE}"

echo "Generated bake configuration:"
cat "${BAKE_FILE}"
echo ""

echo "=== Building images in parallel ==="
docker buildx bake --allow=fs.read=${PACKAGE_DIR} --metadata-file "${METADATA_FILE}" -f "${BAKE_FILE}" "$@"

# The VMM image the bake just loaded, if it built one, as the digests of its
# config and manifest: the engine's image store IDs it by one or the other.
VMM_BUILT=$(jq -r '."connector-vmm" // empty | [."containerimage.config.digest", ."containerimage.digest"] | map(select(.)) | join(" ")' "${METADATA_FILE}")
if [[ -n "${VMM_BUILT}" ]]; then
    VMM_ID=$(docker image inspect --format '{{.Id}}' "ghcr.io/estuary/connector-vmm:${TAGS[0]}")
    [[ " ${VMM_BUILT} " == *" ${VMM_ID} "* ]] \
        || { echo "Error: ghcr.io/estuary/connector-vmm:${TAGS[0]} is not the image the bake built" >&2; exit 1; }
    "$(dirname "$0")/connector-vmm-gate" "${VMM_ID}"
    # Launchers refuse an image whose build is not a clean commit's.
    BUILD=$(docker run --rm --network=none --cap-drop=all --cap-add=CAP_NET_ADMIN "${VMM_ID}" \
        boundary verify 2>/dev/null | grep '^flow-connector-vmm build ' || true)
    echo "${VMM_ID}: ${BUILD}"
    for TAG in "${TAGS[@]}"; do
        VMM_TAG="ghcr.io/estuary/connector-vmm:${TAG}"
        [[ "$(docker image inspect --format '{{.Id}}' "${VMM_TAG}")" == "${VMM_ID}" ]] \
            || { echo "Error: ${VMM_TAG} is not the gated image ${VMM_ID}" >&2; exit 1; }
        if [[ "${PUSH}" == "true" ]]; then
            [[ "${BUILD}" =~ ^flow-connector-vmm\ build\ [0-9a-f]{40}$ ]] \
                || { echo "Error: not publishing ${VMM_TAG}, whose build is not a clean commit's" >&2; exit 1; }
            docker push --quiet "${VMM_TAG}"
        fi
    done
fi

echo ""
echo "Done! Built images for tags: ${TAGS[*]}"
if [[ "${PUSH}" == "true" ]]; then
    echo "Images pushed to ghcr.io/estuary/"
else
    echo "Images loaded locally"
fi
