#!/usr/bin/env bash
set -euo pipefail

#MISE description="Build and optionally push multi-arch Docker images"

PACKAGE_DIR="${PACKAGE_DIR:-${HOME}/flow-package}"
TAGS_FILE="${PACKAGE_DIR}/tags"
PUSH="${PUSH:-false}"

# A publication builds exactly what this script configures: bake arguments
# could change a target's output, platforms or context.
if [[ "${PUSH}" == "true" && $# -gt 0 ]]; then
    echo "Error: refusing custom bake arguments when pushing: $*" >&2
    exit 1
fi
# Published launchers and the VMM must report the expected clean source commit.
if [[ "${PUSH}" == "true" && -z "${EXPECTED_COMMIT:-}" ]]; then
    echo "Error: pushing requires EXPECTED_COMMIT, the commit the package was built from" >&2
    exit 1
fi
if [[ -n "${EXPECTED_COMMIT:-}" && ! "${EXPECTED_COMMIT}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "Error: EXPECTED_COMMIT '${EXPECTED_COMMIT}' is not a full commit ID" >&2
    exit 1
fi

# Validate required files exist
if [[ ! -f "${TAGS_FILE}" ]]; then
    echo "Error: Tags file not found at ${TAGS_FILE}" >&2
    exit 1
fi

if [[ ! -d "${PACKAGE_DIR}/amd64" ]] && [[ ! -d "${PACKAGE_DIR}/arm64" ]]; then
    echo "Error: Missing architecture directories in ${PACKAGE_DIR}" >&2
    exit 1
fi

# For EXPECTED_COMMIT, each architecture's package must be exactly the files
# ci:package recorded, from that commit's builds. A publication needs both.
for PACKAGE_ARCH in amd64 arm64; do
    if [[ -z "${EXPECTED_COMMIT:-}" ]] || [[ ! -d "${PACKAGE_DIR}/${PACKAGE_ARCH}" && "${PUSH}" != "true" ]]; then
        continue
    fi
    SUMS="${PACKAGE_DIR}/${PACKAGE_ARCH}.sha256"
    RECORD="${PACKAGE_DIR}/${PACKAGE_ARCH}.build"
    [[ -f "${SUMS}" && -f "${RECORD}" ]] \
        || { echo "Error: the ${PACKAGE_ARCH} package has no ${SUMS} and ${RECORD}; run ci:package" >&2; exit 1; }
    (cd "${PACKAGE_DIR}" && sha256sum --check --strict --quiet "${SUMS}") \
        || { echo "Error: the ${PACKAGE_ARCH} package differs from ${SUMS}" >&2; exit 1; }
    UNLISTED=$(cd "${PACKAGE_DIR}" && comm -23 <(find "${PACKAGE_ARCH}" ! -type d | sort) <(cut -c67- "${SUMS}" | sort))
    [[ -z "${UNLISTED}" ]] \
        || { echo "Error: the ${PACKAGE_ARCH} package holds files ${SUMS} does not list: ${UNLISTED//$'\n'/ }" >&2; exit 1; }
    if ! cmp -s "${RECORD}" <(printf '%s %s\n' source "${EXPECTED_COMMIT}" \
        flowctl "${EXPECTED_COMMIT}" flowctl-go "${EXPECTED_COMMIT}"); then
        echo "Error: the ${PACKAGE_ARCH} package was not built from ${EXPECTED_COMMIT}:" >&2
        sed 's/^/  /' "${RECORD}" >&2
        exit 1
    fi
done

# Read comma-separated tags into array
IFS=',' read -ra TAGS <<< "$(cat "${TAGS_FILE}")"

# Determine platforms and output type based on push mode
if [[ "${PUSH}" == "true" ]]; then
    PLATFORMS='["linux/amd64", "linux/arm64"]'
    OUTPUT='["type=registry"]'
    # BuildKit scans each built image and pushes the SBOM beside it. The
    # provenance matches buildx's default. Listing it explicitly keeps it
    # when BUILDX_NO_DEFAULT_ATTESTATIONS is set.
    ATTEST='["type=provenance,mode=min", "type=sbom"]'
else
    # For local builds, detect current architecture
    ARCH=$(uname -m)
    if [[ "${ARCH}" == "x86_64" ]]; then
        PLATFORMS='["linux/amd64"]'
    elif [[ "${ARCH}" == "aarch64" ]]; then
        PLATFORMS='["linux/arm64"]'
    else
        echo "Error: Unknown architecture ${ARCH}" >&2
        exit 1
    fi
    OUTPUT='["type=docker"]'
    # No SBOM: with any attestation requested, buildx refuses to load the
    # image into a daemon using the classic image store.
    ATTEST='[]'
fi

# Ensure buildx builder exists and supports multi-arch
BUILDER_NAME="flow-multiarch"
if ! docker buildx inspect "${BUILDER_NAME}" &>/dev/null; then
    echo "Creating buildx builder: ${BUILDER_NAME}"
    docker buildx create --name "${BUILDER_NAME}" --use --bootstrap
else
    docker buildx use "${BUILDER_NAME}"
fi

# Generate bake JSON dynamically from Dockerfiles
BAKE_FILE=$(mktemp)
METADATA_FILE=$(mktemp)
trap "rm -f ${BAKE_FILE} ${METADATA_FILE}" EXIT

# Build the targets object by iterating over Dockerfiles
TARGETS_JSON="{}"
TARGET_NAMES=()

for DOCKERFILE in docker/*.Dockerfile; do
    IMAGE_NAME=$(basename "${DOCKERFILE}" .Dockerfile)

    # The real VMM is amd64-only; the fake is built by the KVM harness.
    case "${IMAGE_NAME}" in
    connector-vmm-fake) continue ;;
    connector-vmm) IMAGE_SUPPORTED='["linux/amd64"]' ;;
    *) IMAGE_SUPPORTED="${PLATFORMS}" ;;
    esac
    # The VMM image is loaded, never pushed, by the bake: it is gated below,
    # and only the image which passed is published.
    IMAGE_OUTPUT="${OUTPUT}"
    IMAGE_ATTEST="${ATTEST}"
    if [[ "${IMAGE_NAME}" == connector-vmm ]]; then
        IMAGE_OUTPUT='["type=docker"]'
        # A loaded image can't carry attestations (see ATTEST above).
        IMAGE_ATTEST='[]'
    fi
    IMAGE_PLATFORMS=$(echo "${PLATFORMS}" | jq -c --argjson supported "${IMAGE_SUPPORTED}" \
        '[.[] | select(. as $platform | $supported | index($platform))]')
    if [[ "${IMAGE_PLATFORMS}" == "[]" ]]; then
        echo "Skipping ${IMAGE_NAME}: built only for ${IMAGE_SUPPORTED}"
        continue
    fi
    TARGET_NAMES+=("${IMAGE_NAME}")

    # Per-image tags begin with the version tags from ${TAGS_FILE}.
    IMAGE_TAG_NAMES=("${TAGS[@]}")

    # Custom connectors resolve to the `:stable` image, while legacy
    # V1 derivations keep using a frozen `:dev` image (no longer rebuilt here).
    # Publish `:stable` for these.
    if [[ "${IMAGE_NAME}" == "capture-python" || "${IMAGE_NAME}" == "derive-python" || "${IMAGE_NAME}" == "derive-typescript" || "${IMAGE_NAME}" == "materialize-python" ]]; then
        IMAGE_TAG_NAMES+=("stable")
    fi

    # Build tags array for this image
    IMAGE_TAGS=$(printf '%s\n' "${IMAGE_TAG_NAMES[@]}" | jq -R '"ghcr.io/estuary/'"${IMAGE_NAME}"':\(.)"' | jq -s '.')

    # Use absolute path for dockerfile since context is different from CWD
    DOCKERFILE_ABS="$(pwd)/${DOCKERFILE}"

    # Add target to targets object
    TARGETS_JSON=$(echo "${TARGETS_JSON}" | jq \
        --arg name "${IMAGE_NAME}" \
        --arg dockerfile "${DOCKERFILE_ABS}" \
        --arg context "${PACKAGE_DIR}" \
        --argjson tags "${IMAGE_TAGS}" \
        --argjson platforms "${IMAGE_PLATFORMS}" \
        --argjson output "${IMAGE_OUTPUT}" \
        --argjson attest "${IMAGE_ATTEST}" \
        '.[$name] = {
            "dockerfile": $dockerfile,
            "context": $context,
            "tags": $tags,
            "platforms": $platforms,
            "output": $output,
            "attest": $attest
        }')
done

# Build the complete bake file
TARGET_NAMES_JSON=$(printf '%s\n' "${TARGET_NAMES[@]}" | jq -R '.' | jq -s '.')
jq -n \
    --argjson targets "${TARGET_NAMES_JSON}" \
    --argjson target "${TARGETS_JSON}" \
    '{
        "group": {
            "default": {
                "targets": $targets
            }
        },
        "target": $target
    }' > "${BAKE_FILE}"

echo "Generated bake configuration:"
cat "${BAKE_FILE}"
echo ""

echo "=== Building images in parallel ==="
docker buildx bake --allow=fs.read=${PACKAGE_DIR} --metadata-file "${METADATA_FILE}" -f "${BAKE_FILE}" "$@"

# Image stores identify loaded images by config or manifest digest.
# Full builds and publications require VMM metadata; custom local bakes may omit it.
VMM_BUILT=$(jq -r '."connector-vmm" // empty | [."containerimage.config.digest", ."containerimage.digest"] | map(select(.)) | join(" ")' "${METADATA_FILE}")
if [[ -z "${VMM_BUILT}" ]]; then
    if [[ "${PUSH}" == "true" || ($# -eq 0 && " ${TARGET_NAMES[*]} " == *" connector-vmm "*) ]]; then
        echo "Error: the bake's metadata names no connector-vmm image, so none can be gated" >&2
        exit 1
    fi
    if [[ $# -gt 0 ]]; then
        echo "This bake built no connector-vmm image, so none was gated"
    fi
else
    VMM_ID=$(docker image inspect --format '{{.Id}}' "ghcr.io/estuary/connector-vmm:${TAGS[0]}")
    [[ " ${VMM_BUILT} " == *" ${VMM_ID} "* ]] \
        || { echo "Error: ghcr.io/estuary/connector-vmm:${TAGS[0]} is not the image the bake built" >&2; exit 1; }
    "$(dirname "$0")/connector-vmm-gate" "${VMM_ID}"
    # Launchers refuse an image whose build is not their own clean commit's.
    BUILD=$(docker run --rm --network=none --cap-drop=all --cap-add=CAP_NET_ADMIN "${VMM_ID}" \
        boundary verify 2>/dev/null | grep '^flow-connector-vmm build ' || true)
    echo "${VMM_ID}: ${BUILD}"
    if [[ -n "${EXPECTED_COMMIT:-}" && "${BUILD}" != "flow-connector-vmm build ${EXPECTED_COMMIT}" ]]; then
        echo "Error: ${VMM_ID} reports '${BUILD}', not the expected commit ${EXPECTED_COMMIT}" >&2
        exit 1
    fi
    # Every tag names the gated image before any is pushed, and again as it is.
    require_gated() {
        [[ "$(docker image inspect --format '{{.Id}}' "$1")" == "${VMM_ID}" ]] \
            || { echo "Error: $1 is not the gated image ${VMM_ID}" >&2; exit 1; }
    }
    VMM_TAGS=("${TAGS[@]/#/ghcr.io/estuary/connector-vmm:}")
    for VMM_TAG in "${VMM_TAGS[@]}"; do
        require_gated "${VMM_TAG}"
    done
    if [[ "${PUSH}" == "true" ]]; then
        for VMM_TAG in "${VMM_TAGS[@]}"; do
            require_gated "${VMM_TAG}"
            docker push --quiet "${VMM_TAG}"
        done
    fi
fi

echo ""
echo "Done! Built images for tags: ${TAGS[*]}"
if [[ "${PUSH}" == "true" ]]; then
    echo "Images pushed to ghcr.io/estuary/"
else
    echo "Images loaded locally"
fi
