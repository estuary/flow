#!/usr/bin/env bash
set -euo pipefail

rustup target add $(uname -m)-unknown-linux-musl

# `cargo auditable` embeds each binary's crate list, which image SBOM scanners read.
FLOW_VERSION=$(git describe --dirty --tags) \
cargo auditable build \
    --locked \
    --release \
    --target $(uname -m)-unknown-linux-musl \
    -p capture-python \
    -p connector-init \
    -p derive-python \
    -p derive-typescript \
    -p materialize-python \
    -p parser